@page
@functions {
    public Microsoft.AspNetCore.Mvc.IActionResult OnGet(string? sponsorCode) => Redirect("/Account/Register" + (string.IsNullOrWhiteSpace(sponsorCode) ? "" : "?sponsorCode=" + System.Uri.EscapeDataString(sponsorCode)));
    public Microsoft.AspNetCore.Mvc.IActionResult OnPost() => Redirect("/Account/Register");
}
