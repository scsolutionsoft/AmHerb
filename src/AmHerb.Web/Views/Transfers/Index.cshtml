@model AmHerb.Web.Controllers.TransferPage
@using AmHerb.Web.Controllers
@{ ViewData["Title"] = "เบิกและโอนย้ายสินค้า"; }
<div class="page-heading"><div><p class="eyebrow">STOCK REPLENISHMENT</p><h1>เบิกและโอนย้ายสินค้า</h1><p class="text-muted">ขอเบิก → อนุมัติจ่าย → ระหว่างขนส่ง → ยืนยันรับเข้าคลัง</p></div><a class="btn btn-outline-success" href="/Stock">ดูรายงานสต๊อก</a></div>
<div class="alert alert-info">การเบิกสินค้าเป็นการย้ายสต๊อกระหว่างคลัง ไม่ใช่รายการขายหรือชำระเงิน และไม่สร้างรางวัล Token</div>
<nav class="stock-tabs" aria-label="สถานะใบเบิก"><a href="/Transfers" class="@(Model.Status == null ? "selected" : "")">ทั้งหมด</a>@foreach(var s in Enum.GetValues<TransferStatus>()){<a asp-action="Index" asp-route-status="@s" class="@(Model.Status == s ? "selected" : "")">@TransferPage.Label(s)</a>}</nav>
<details class="card p-4 mb-4" open><summary class="fw-bold">+ สร้างคำขอเบิกสินค้า</summary>
@if(Model.Destinations.Count == 0){<p class="mt-3 mb-0 text-muted">ยังไม่มีคลังปลายทางที่ใช้ได้ กรุณาให้ผู้ดูแลสร้างคลังและกำหนดคุณเป็นเจ้าของ</p>}
else{<form method="post" asp-action="Create" class="row g-3 mt-2"><input name="key" type="hidden" value="@Guid.NewGuid()" /><div class="col-md-6"><label for="transfer-source">คลังต้นทาง</label><select class="form-select" id="transfer-source" name="sourceId" required>@foreach(var w in Model.Sources){<option value="@w.Id">@w.Name</option>}</select></div><div class="col-md-6"><label for="transfer-destination">คลังปลายทาง</label><select class="form-select" id="transfer-destination" name="destinationId" required>@foreach(var w in Model.Destinations){<option value="@w.Id">@w.Name</option>}</select></div><div class="col-md-8"><label for="transfer-sku">สินค้า</label><select class="form-select" id="transfer-sku" name="skuId" required>@foreach(var sku in Model.Skus){<option value="@sku.Id">@sku.Code · @sku.Product.Name</option>}</select></div><div class="col-md-4"><label for="transfer-quantity">จำนวนชิ้น</label><input class="form-control" id="transfer-quantity" type="number" name="quantity" min="1" max="1000000" value="1" required /></div><div class="col-12"><label for="transfer-reason">เหตุผลในการเบิก</label><input class="form-control" id="transfer-reason" name="reason" maxlength="900" required placeholder="เช่น เติมสินค้าเพื่อขายหน้าร้าน" /></div><div class="col-12"><button class="btn btn-success">ส่งคำขอเบิก</button><span class="text-muted small ms-2">ยังไม่ตัดสต๊อกจนกว่าผู้ดูแลอนุมัติจ่าย</span></div></form>}
</details>
<section class="card table-responsive"><table class="table mb-0"><thead><tr><th>ใบเบิก / วันที่</th><th>ต้นทาง → ปลายทาง</th><th>สินค้า</th><th class="text-end">จำนวน</th><th>สถานะ</th></tr></thead><tbody>@foreach(var t in Model.Transfers){<tr><td><a asp-action="Detail" asp-route-id="@t.Id">TR-@t.Id.ToString("D8")</a><div class="small text-muted">@Bangkok.Format(t.CreatedAt)</div></td><td>@t.SourceWarehouse.Name → @t.DestinationWarehouse.Name</td><td>@t.Sku.Product.Name<div class="small text-muted">@t.Sku.Code</div></td><td class="text-end">@t.Quantity.ToString("N0")</td><td><span class="badge @(t.Status == TransferStatus.Dispatched ? "stock-warning" : t.Status == TransferStatus.Received ? "stock-good" : "")">@TransferPage.Label(t.Status)</span></td></tr>}@if(Model.Transfers.Count==0){<tr><td colspan="5" class="text-center py-5 text-muted">ยังไม่มีใบเบิกในสถานะนี้</td></tr>}</tbody></table></section>
<div class="d-flex gap-3 mt-3">@if(Model.Page>1){<a asp-action="Index" asp-route-status="@Model.Status" asp-route-page="@(Model.Page-1)">← ก่อนหน้า</a>}<span>หน้า @Model.Page</span>@if(Model.HasNext){<a asp-action="Index" asp-route-status="@Model.Status" asp-route-page="@(Model.Page+1)">ถัดไป →</a>}</div>


