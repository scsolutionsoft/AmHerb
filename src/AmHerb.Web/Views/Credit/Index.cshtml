@model CreditListModel
@{ViewData["Title"]="เครดิตสมาชิกและลูกหนี้";}
<div class="page-heading"><div><p class="eyebrow">MEMBER CREDIT & RECEIVABLES</p><h1>เครดิตสมาชิกและลูกหนี้</h1><p>วงเงินซื้อสินค้า · รับโอนชำระหนี้ · ติดตามยอดคงค้าง</p></div><div class="d-flex gap-2 no-print">@if(Model.Finance){<a href="/Accounting" class="btn btn-outline-success">บัญชีเดบิต–เครดิต</a>}<button class="btn btn-success" data-print>พิมพ์รายงาน</button></div></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric-card"><span>บัญชีเครดิตตามตัวกรอง</span><strong>@Model.Total</strong></div></div><div class="col-md-4"><div class="metric-card"><span>หนี้คงค้างรวม</span><strong>฿@Model.Used.ToString("N2")</strong></div></div><div class="col-md-4"><div class="metric-card"><span>หนี้เกินกำหนด</span><strong class="text-danger">฿@Model.Overdue.ToString("N2")</strong></div></div></div>
<form method="get" class="search-bar d-flex gap-2 mb-4 no-print"><input name="q" value="@Model.Search" class="form-control" placeholder="ค้นหาชื่อหรือรหัสสมาชิก" aria-label="ค้นหาบัญชีเครดิต"/><button class="btn btn-success">ค้นหา</button></form>
<div class="card table-responsive"><table class="table mb-0"><thead><tr><th>สมาชิก</th><th>ประเภท / สิทธิ์</th><th>วงเงิน</th><th>ใช้ไป</th><th>คงเหลือ</th><th>เกินกำหนด</th><th></th></tr></thead><tbody>@foreach(var a in Model.Rows){<tr><td>@a.Name<br/><small>@a.Code</small></td><td>@(a.MasterDealer?"มาสเตอร์ดีลเลอร์":"สมาชิกที่ได้รับสิทธิ์")<br/><span class="badge">@(a.Enabled?"เปิดเครดิต":"ระงับซื้อเพิ่ม") · @a.Days วัน</span></td><td>@a.Limit.ToString("N2")</td><td>@a.Used.ToString("N2")</td><td>@Math.Max(0,a.Limit-a.Used).ToString("N2")</td><td class="text-danger">@a.Overdue.ToString("N2")</td><td>@if(a.Pending>0){<span class="badge text-bg-warning mb-2">รอตรวจยอดโอน @a.Pending รายการ</span>}<a href="/Credit/Account/@a.Id" class="btn btn-outline-success">เปิดบัญชี</a></td></tr>}</tbody></table></div>
@if(Model.Total==0){<div class="card p-4 text-center">ยังไม่มีบัญชีเครดิตที่ตรงกับการค้นหา @if(!Model.Finance){<p class="mb-0 text-muted">ติดต่อบริษัทเพื่อขอสิทธิ์และวงเงินเครดิต</p>}</div>}
<p class="small text-muted mt-3">รายงานยอดปัจจุบัน · หน้า @Model.Page · แสดงไม่เกิน 50 บัญชีต่อหน้า · ยอดรวมครอบคลุมทุกบัญชีที่ตรงกับตัวกรอง</p><div class="d-flex gap-2 no-print">@if(Model.Page>1){<a asp-action="Index" asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Search">← ก่อนหน้า</a>}@if(Model.Page*50<Model.Total){<a asp-action="Index" asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Search">ถัดไป →</a>}</div>
@if(Model.Finance){<details class="card p-4 mt-4 no-print"><summary>เปิดบัญชีเครดิตให้สมาชิก / มาสเตอร์ดีลเลอร์</summary><form asp-action="Configure" method="post" class="row g-3 mt-2"><div class="col-md-4"><label for="credit-code">รหัสสมาชิก</label><input name="code" id="credit-code" class="form-control" required maxlength="40"/><a href="/Admin?section=Members" class="small">ค้นหารหัสจากรายชื่อสมาชิก</a></div><div class="col-md-4"><label for="credit-limit">วงเงิน (บาท)</label><input name="limit" id="credit-limit" type="number" min="0" max="100000000" step="0.01" class="form-control" required/></div><div class="col-md-4"><label for="credit-days">เครดิต (วัน)</label><input name="days" id="credit-days" type="number" min="1" max="365" value="30" class="form-control" required/></div><div class="col-12 d-flex flex-wrap gap-4"><label><input type="checkbox" name="enabled" value="true" checked/> เปิดสิทธิ์ซื้อด้วยเครดิต</label><label><input type="checkbox" name="master" value="true"/> มาสเตอร์ดีลเลอร์</label></div><div class="col-12"><label for="credit-reason">เหตุผล / เลขที่อนุมัติ</label><input name="reason" id="credit-reason" class="form-control" required maxlength="1000"/></div><div><button class="btn btn-success">อนุมัติวงเงิน</button></div></form></details>}

