@model Conversation
@using AmHerb.Web.Controllers
@{ViewData["Title"]=Model.Subject;var staff=ConversationService.Staff(User);}
<div class="page-heading"><div><p class="eyebrow">MEMBER CARE · #@Model.Id</p><h1 class="h2">@Model.Subject</h1><p>@MessagesController.Label(Model.Status)</p></div><a href="/Messages" class="btn btn-outline-success">กลับศูนย์ข้อความ</a></div>
<section class="card p-3 p-lg-4 chat-thread">@foreach(var message in Model.Messages.OrderBy(x=>x.Id)){<article class="chat-bubble @(message.FromStaff==staff?"mine":"")"><strong>@(message.FromStaff?"AM HERB Member Care":Model.Member.Name)</strong><p>@message.Body</p><small>@Bangkok.Format(message.SentAt) · @(message.ReadAt==null?"ส่งแล้ว":"อ่านแล้ว")</small></article>}</section>
<form asp-action="Read" method="post" data-mark-read><input type="hidden" name="id" value="@Model.Id"/></form>
@if(Model.Status!=ConversationStatus.Closed){<form asp-action="Send" method="post" class="card p-4 mt-3"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="key" value="@Guid.NewGuid()"/><label for="reply-body">ตอบกลับ</label><textarea class="form-control mb-3" id="reply-body" name="body" rows="4" maxlength="4000" required></textarea><button class="btn btn-success align-self-end">ส่งคำตอบ</button></form><details class="mt-3"><summary>ปิดเรื่องนี้</summary><form asp-action="Close" method="post" class="d-flex gap-2 mt-3"><input type="hidden" name="id" value="@Model.Id"/><input class="form-control" name="reason" maxlength="500" placeholder="เหตุผลปิดเรื่อง" aria-label="เหตุผลปิดเรื่อง" required/><button class="btn btn-outline-success text-nowrap">ปิดเรื่อง</button></form></details>}
