@model RegisterInput
@{ ViewData["Title"] = "สมัครสมาชิก"; var invalidSponsor = !string.IsNullOrWhiteSpace(Model.SponsorCode) && ViewBag.SponsorName == null; }
<div class="mx-auto" style="max-width:760px"><a href="/Account/Join" class="d-inline-block mb-3">← วิธีสมัคร / มีบัญชีอยู่แล้ว</a><section class="card p-4 p-lg-5"><p class="eyebrow">JOIN AM HERB</p><h1 class="h2">สมัครสมาชิกใหม่</h1><p class="text-muted">เพียง 3 ขั้นตอน แล้วตรวจอีเมลเพื่อเริ่มใช้งาน</p>
<ol class="list-unstyled d-flex flex-wrap gap-2 mb-4" aria-label="ขั้นตอนสมัคร"><li class="badge text-bg-success" data-register-indicator>1 ข้อมูลส่วนตัว</li><li class="badge text-bg-light" data-register-indicator>2 ตั้งรหัสผ่าน</li><li class="badge text-bg-light" data-register-indicator>3 ตรวจและยืนยัน</li></ol>
<form method="post" asp-action="Register" id="register-wizard"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="SponsorCode" type="hidden" />
@if(invalidSponsor) { <div class="alert alert-warning">ยังไม่สามารถสมัครด้วยรหัสแนะนำนี้ได้ <a href="/Account/Join">กลับไปตรวจรหัสแนะนำ</a></div> }
<section data-register-step><h2 class="h4" tabindex="-1">ข้อมูลของคุณ</h2><p class="small text-muted">ใช้อีเมลที่เปิดอ่านได้ เพื่อรับลิงก์ยืนยันบัญชี</p><label asp-for="Name" class="form-label">ชื่อ-นามสกุล</label><input asp-for="Name" class="form-control mb-3" autocomplete="name" required maxlength="160" /><label asp-for="Email" class="form-label">อีเมล</label><input asp-for="Email" type="email" class="form-control mb-3" autocomplete="email" required maxlength="256" /></section>
<section data-register-step><h2 class="h4" tabindex="-1">ตั้งรหัสผ่านที่จำได้</h2><p id="password-help" class="small text-muted">ใช้ 5–10 ตัวอักษร ไม่บังคับตัวใหญ่ ตัวเลข หรือสัญลักษณ์</p><label asp-for="Password" class="form-label">รหัสผ่าน</label><input asp-for="Password" class="form-control mb-3" autocomplete="new-password" required minlength="5" maxlength="10" aria-describedby="password-help" /><label asp-for="ConfirmPassword" class="form-label">พิมพ์รหัสผ่านอีกครั้ง</label><input asp-for="ConfirmPassword" class="form-control mb-3" autocomplete="new-password" required minlength="5" maxlength="10" /><label class="form-check mb-3"><input id="show-register-password" type="checkbox" class="form-check-input" /> แสดงรหัสผ่าน</label></section>
<section data-register-step><h2 class="h4" tabindex="-1">ตรวจข้อมูลก่อนสร้างบัญชี</h2><dl class="bg-light p-3 rounded-3" id="register-review" hidden><dt>ชื่อ-นามสกุล</dt><dd data-review-name></dd><dt>อีเมลรับลิงก์ยืนยัน</dt><dd data-review-email class="text-break"></dd></dl><div class="alert alert-success"><strong>ผู้แนะนำของคุณ</strong><p class="mb-0">@(ViewBag.SponsorName ?? (invalidSponsor ? "ไม่พบผู้แนะนำ" : "สมัครโดยไม่มีผู้แนะนำ"))</p>@if(ViewBag.SponsorName != null) { <small>หลังสมัคร คุณจะอยู่ในดาวน์ไลน์โดยตรงของผู้แนะนำนี้</small> }</div><a class="small" href="/Account/Join">ผู้แนะนำไม่ถูกต้อง? กลับไปเลือกรูปแบบสมัคร</a><p class="small text-muted mt-3">เมื่อสร้างบัญชี ระบบจะส่งอีเมลยืนยันให้คุณ ไม่มีรางวัลจากการสมัครหรือแนะนำสมาชิก</p></section>
<div class="d-flex justify-content-between gap-2 mt-4"><button type="button" class="btn btn-outline-success" data-register-back hidden>ย้อนกลับ</button><button type="button" class="btn btn-success ms-auto" data-register-next hidden>ถัดไป →</button><button class="btn btn-success ms-auto" type="submit" id="register-submit" disabled="@invalidSponsor">ยืนยันและสร้างบัญชี</button></div><noscript><p class="small mt-3">กรอกข้อมูลทุกส่วนแล้วกดยืนยันและสร้างบัญชี</p></noscript></form><hr /><p class="small mb-0">มีบัญชีแล้ว? <a href="/Identity/Account/Login">เข้าสู่ระบบ</a> · <a href="/Identity/Account/ResendEmailConfirmation">ส่งอีเมลยืนยันอีกครั้ง</a></p></section></div>
@section Scripts { <script src="~/js/register-wizard.js" asp-append-version="true"></script> }