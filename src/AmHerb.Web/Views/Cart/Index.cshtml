@model CartModel
@{ ViewData["Title"] = "ตะกร้าและชำระเงิน"; }
@if (Model.Store != null) { <div class="alert alert-info">ร้าน @Model.Store.Name · จัดส่งจากคลังสมาชิก · ฝ่ายการเงินตรวจรับเงิน <a href="/s/@Model.Store.Slug">เลือกสินค้าเพิ่ม</a></div> } <p class="eyebrow">YOUR WELLNESS SELECTION</p><h1 class="mb-4">ตะกร้าสินค้า</h1>
@if (Model.Lines.Count == 0) { <div class="empty-state"><h2 class="h4">ยังไม่มีสินค้าในตะกร้า</h2><a href="@(Model.Store == null ? "/Catalog" : "/s/" + Model.Store.Slug)" class="btn btn-success mt-3">เลือกซื้อสินค้า</a></div> }
else { <div class="row g-4"><div class="col-lg-7"><div class="card p-4">
@foreach (var line in Model.Lines) { <div class="cart-row"><div><img class="circle-thumb me-2" src="/Media/Thumb/@line.SkuId" alt="@line.Name"/><h2 class="h6">@line.Name · @line.Tier</h2><span class="text-muted">฿@line.UnitPrice.ToString("N2") / ชิ้น</span></div><form asp-action="Update" asp-route-slug="@Model.Store?.Slug" method="post" class="d-flex gap-2"><input type="hidden" name="skuId" value="@line.SkuId" /><input type="hidden" name="tier" value="@line.Tier" /><input type="number" name="quantity" value="@line.Quantity" min="0" max="10000" class="form-control quantity" aria-label="จำนวนสินค้า" /><button class="btn btn-outline-success btn-sm">อัปเดต</button></form><strong>@((line.Quantity * line.UnitPrice).ToString("N2"))</strong></div> }
<div class="d-flex justify-content-between mt-4"><span>มูลค่าสินค้า</span><strong>฿@Model.Total.ToString("N2")</strong></div><div class="d-flex justify-content-between mt-2"><span>ค่าจัดส่งก่อนใช้คูปอง</span><strong>฿@Model.ShippingFee.ToString("N2")</strong></div>
<p class="small text-muted mt-3">ปรับจำนวนเป็น 0 เพื่อลบสินค้า ยอดสุดท้ายและค่าจัดส่งจะคำนวณอีกครั้งเมื่อยืนยันคำสั่งซื้อ</p></div></div>
<div class="col-lg-5"><partial name="~/Views/Cart/_CheckoutWizard.cshtml" model="Model" /></div></div> }
@section Scripts { <script src="~/js/checkout-wizard.js" asp-append-version="true"></script> }