@model AmHerb.Web.Controllers.StoreAccountingPage
@{ ViewData["Title"] = "บัญชีร้าน"; }
<h1>บัญชีร้าน @Model.Store.Name</h1><partial name="_StoreNav"/>
<form method="get" class="d-flex flex-wrap gap-2 mb-3"><label>จาก <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control"/></label><label>ถึง <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control"/></label><button class="btn btn-success align-self-end">ดูรายงาน</button><a class="btn btn-outline-success align-self-end" asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">ส่งออก CSV</a><button type="button" data-print class="btn btn-outline-secondary align-self-end">พิมพ์</button></form>
<p class="small text-muted">ตามวันที่ลงรายการ (เวลาไทย) รวมออนไลน์ร้านและ POS ของคุณ ต้นทุนใช้ต้นทุนล็อตที่บันทึกในระบบ ยอดรับผ่านบริษัทเป็นยอดรับชำระของออเดอร์ ยังไม่ใช่หลักฐานการโอนเงินให้สมาชิก</p>
<div class="row g-3 mb-4">@foreach(var m in new[] { ("ยอดขายสุทธิ", Model.Sales), ("ต้นทุนล็อต", Model.Cost), ("ส่วนลด Token", Model.TokenDiscount), ("ค่าใช้จ่าย", Model.ExpenseTotal), ("ส่วนต่างหลังต้นทุน / Token / ค่าใช้จ่าย", Model.Sales - Model.Cost - Model.TokenDiscount - Model.ExpenseTotal) }) { <div class="col-md-4"><div class="card p-3"><span>@m.Item1</span><strong class="h3">@m.Item2.ToString("N2")</strong></div></div> }</div>
<details class="card p-3 mb-4 no-print"><summary>บันทึกค่าใช้จ่ายร้าน</summary><form asp-action="Expense" method="post" class="row g-2 mt-2"><input type="hidden" name="key" value="@Guid.NewGuid()"/><div class="col-md-3"><label>วันที่<input type="date" name="day" value="@DateTime.UtcNow.AddHours(7).ToString("yyyy-MM-dd")" required class="form-control"/></label></div><div class="col-md-3"><label>ยอดเงิน<input type="number" name="amount" min="0.01" max="10000000" step="0.01" required class="form-control"/></label></div><div class="col-md-6"><label>รายละเอียด<input name="description" maxlength="200" required class="form-control"/></label></div><div class="col-md-9"><label>เลขอ้างอิงหลักฐาน<input name="reference" maxlength="200" class="form-control"/></label></div><div class="col-md-3 align-self-end"><button class="btn btn-success">บันทึก</button></div></form></details>
<h2 class="h4">รายการขายและคืนสินค้า</h2><div class="table-responsive"><table class="table"><thead><tr><th>วันที่</th><th>เอกสาร</th><th>บัญชี</th><th>เดบิต</th><th>เครดิต</th></tr></thead><tbody>@foreach(var j in Model.Journals) { foreach(var l in j.Lines) { <tr><td>@Bangkok.Format(j.PostedAt)</td><td><a href="/Orders/Detail/@j.Order.PublicId">@j.Order.Number</a><small class="d-block">@j.Description</small></td><td>@l.Name</td><td>@l.Debit.ToString("N2")</td><td>@l.Credit.ToString("N2")</td></tr> } }</tbody></table></div>
<h2 class="h4">ค่าใช้จ่าย</h2><div class="table-responsive"><table class="table"><thead><tr><th>วันที่</th><th>รายการ / หลักฐาน</th><th>ยอด</th><th>แก้ไขโดยรายการกลับรายการ</th></tr></thead><tbody>@foreach(var e in Model.Expenses) { <tr><td>@Bangkok.Format(e.OccurredAt)</td><td>@e.Description <small>@e.Reference</small></td><td>@e.Amount.ToString("N2")</td><td>@if(e.Amount > 0 && !Model.Expenses.Any(x => x.ReversesId == e.Id)) { <form asp-action="ReverseExpense" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@e.Id"/><input name="reason" maxlength="160" required placeholder="เหตุผลยกเลิก" aria-label="เหตุผลยกเลิก" class="form-control"/><button class="btn btn-outline-danger">ยกเลิก</button></form> }</td></tr> }</tbody></table></div>
