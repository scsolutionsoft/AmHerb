@model AmHerb.Web.Controllers.ShippingLabelPage
@{ Layout = null; var o = Model.Order; var sourceAddress = Model.SenderAddress ?? ""; var senderPostcode = System.Text.RegularExpressions.Regex.Match(sourceAddress, @"(?<!\d)[1-9][0-9]{4}\s*$").Value.Trim(); var senderAddress = senderPostcode.Length == 5 ? sourceAddress.TrimEnd()[..^5].TrimEnd() : sourceAddress; var recipientAddress = !string.IsNullOrWhiteSpace(o.PostalCode) && o.Address.TrimEnd().EndsWith(o.PostalCode) ? o.Address.TrimEnd()[..^o.PostalCode.Length].TrimEnd() : o.Address; }
<!doctype html><html lang="th"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>ใบจ่าหน้า @o.Number · A5</title><link rel="stylesheet" href="~/css/shipping-label.css" asp-append-version="true" /></head>
<body>
<header class="tools"><a href="@(ViewBag.LabelBackUrl ?? "/MyStore/Orders")">← กลับรายการออเดอร์</a><h1>ใบปะหน้ากล่องพัสดุ A5</h1><p>1 ตรวจข้อมูล → 2 ดูตัวอย่าง → 3 พิมพ์และติดพัสดุ</p>
<p>ตั้งค่ากระดาษ <strong>A5 แนวตั้ง · ขนาดจริง 100%</strong> และปิดหัว/ท้ายกระดาษในหน้าต่างพิมพ์ สามารถเลือกบันทึกเป็น PDF ได้</p>
@if(o.Status == OrderStatus.PendingPayment) { <p class="notice">ออเดอร์ยังรอชำระเงิน ตรวจสอบการรับเงินก่อนส่งสินค้า</p> }
<details><summary>แก้ข้อมูลผู้ส่งสำหรับการพิมพ์ครั้งนี้</summary><p>ค่าเริ่มต้นใช้ชื่อ/โทรศัพท์ร้านและที่อยู่ใน <a href="/Member#profile">โปรไฟล์สมาชิก</a> ข้อมูลที่แก้ด้านล่างไม่บันทึกกลับระบบ</p><div class="fields"><label>ชื่อผู้ส่ง<input id="sender-name" maxlength="160" value="@Model.SenderName" /></label><label>โทรศัพท์<input id="sender-phone" maxlength="40" value="@Model.SenderPhone" /></label><label>ที่อยู่ผู้ส่ง (บ้านเลขที่ ถนน ตำบล อำเภอ จังหวัด)<textarea id="sender-address" maxlength="1000" rows="3">@senderAddress</textarea></label><label>รหัสไปรษณีย์ผู้ส่ง<input id="sender-postcode" inputmode="numeric" maxlength="5" pattern="[1-9][0-9]{4}" value="@senderPostcode" /></label></div></details>
<p id="print-error" role="alert" class="notice" hidden></p><button id="print-label" type="button">พิมพ์ใบจ่าหน้า A5</button><p class="hint">พิมพ์บนกระดาษสีขาวแล้วติดบนด้านเรียบของกล่อง ให้ที่อยู่และรหัสไปรษณีย์อ่านได้ชัดเจน ใบนี้ใช้จ่าหน้า ยังต้องชำระค่าฝากส่ง</p><p class="hint"><a href="https://www.thailandpost.co.th/PR/youtube_vdo/pdf/how_to_packing.pdf" target="_blank" rel="noopener">คำแนะนำการจ่าหน้าและบรรจุหีบห่อจากไปรษณีย์ไทย</a></p></header>
<main class="preview"><article class="label-sheet" aria-label="ตัวอย่างใบจ่าหน้า A5">
<div class="label-top"><section class="sender"><h2>ผู้ส่ง / FROM</h2><strong data-sender="name">@Model.SenderName</strong><div data-sender="address">@senderAddress</div><div>โทร <span data-sender="phone">@Model.SenderPhone</span></div><div>รหัสไปรษณีย์ <strong data-sender="postcode">@senderPostcode</strong></div></section><div class="postage-space" aria-hidden="true">พื้นที่สำหรับเจ้าหน้าที่<br />ติดป้ายบริการไปรษณีย์</div></div>
<section class="recipient"><h2>ชื่อและที่อยู่ผู้รับ / TO</h2><h3 data-recipient-name>@o.CustomerName</h3><p data-recipient-address>@recipientAddress</p><p>โทร @o.Phone</p>@if(o.PostalCode.Length == 5) { <div class="postcode" data-recipient-postcode="@o.PostalCode" aria-label="รหัสไปรษณีย์ @o.PostalCode">@foreach(var digit in o.PostalCode) { <span>@digit</span> }</div> }</section>
<footer><span>อ้างอิง @o.Number</span><span>@o.SelectedCarrier</span></footer>
</article></main><script src="~/js/shipping-label.js" asp-append-version="true"></script></body></html>
