@model List<JournalEntry>
@{ViewData["Title"]="บัญชีการขาย เดบิต–เครดิต";var lines=Model.SelectMany(x=>x.Lines).ToList();}
<partial name="_OperationsNav" /><div class="page-heading"><div><p class="eyebrow">SALES SUBLEDGER</p><h1>บัญชีการขาย เดบิต–เครดิต</h1><p>บัญชีย่อยเพื่อบริหาร เริ่มบันทึกอัตโนมัติจากรายการชำระและคืนเงินหลังเปิดโมดูลนี้</p></div><button class="btn btn-success no-print" data-print>ตัวอย่างก่อนพิมพ์</button></div>
<p class="no-print"><a href="/Credit" class="btn btn-outline-success">จัดการวงเงินเครดิต / รับโอนชำระหนี้ / รายงานลูกหนี้ →</a></p><form method="get" class="card p-3 d-flex flex-row flex-wrap gap-3 mb-4 no-print"><div><label for="journal-from">ตั้งแต่ (เวลาไทย)</label><input class="form-control" type="date" name="from" id="journal-from" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))"/></div><div><label for="journal-to">ถึง</label><input class="form-control" type="date" name="to" id="journal-to" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))"/></div><div><label for="journal-origin">แหล่งขาย</label><select id="journal-origin" name="origin" class="form-select">@foreach(var option in OperationsOrders.Origins) { <option value="@option.Key" selected="@(option.Key == (string)ViewBag.Origin)">@option.Value</option> }</select></div><div><label for="journal-member">รหัสสมาชิกที่เกี่ยวข้อง (ผู้ซื้อ / ผู้ขาย)</label><input id="journal-member" name="memberCode" value="@ViewBag.MemberCode" class="form-control" /></div><button class="btn btn-success align-self-end">แสดงรายงาน</button></form>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric-card"><span>เดบิตรวม</span><strong>@lines.Sum(x=>x.Debit).ToString("N2")</strong></div></div><div class="col-md-4"><div class="metric-card"><span>เครดิตรวม</span><strong>@lines.Sum(x=>x.Credit).ToString("N2")</strong></div></div><div class="col-md-4"><div class="metric-card"><span>ผลต่าง</span><strong>@(lines.Sum(x=>x.Debit-x.Credit).ToString("N2"))</strong></div></div></div>
<h2 class="h4">สรุปยอดเคลื่อนไหวตามบัญชี</h2><div class="card table-responsive mb-4"><table class="table mb-0"><thead><tr><th>รหัสบัญชี</th><th>ชื่อบัญชี</th><th class="text-end">เดบิต</th><th class="text-end">เครดิต</th></tr></thead><tbody>@foreach(var group in lines.GroupBy(x=>new{x.Account,x.Name}).OrderBy(x=>x.Key.Account)){<tr><td>@group.Key.Account</td><td>@group.Key.Name</td><td class="text-end">@group.Sum(x=>x.Debit).ToString("N2")</td><td class="text-end">@group.Sum(x=>x.Credit).ToString("N2")</td></tr>}</tbody></table></div>
<h2 class="h4">สมุดรายวันขาย รับชำระหนี้ และคืนสินค้า</h2>@foreach(var entry in Model){<section class="card mb-3 p-3"><a href="/Orders/Detail/@entry.Order.PublicId">@entry.Order.Number → ออเดอร์ต้นทาง</a><strong>JV-@entry.Id.ToString("D8") · @entry.Description</strong><small class="text-muted">@Bangkok.Format(entry.PostedAt) · @entry.EventKey</small><div class="table-responsive"><table class="table mb-0"><thead><tr><th>บัญชี</th><th class="text-end">เดบิต</th><th class="text-end">เครดิต</th></tr></thead><tbody>@foreach(var line in entry.Lines){<tr><td>@line.Account · @line.Name</td><td class="text-end">@line.Debit.ToString("N2")</td><td class="text-end">@line.Credit.ToString("N2")</td></tr>}</tbody></table></div></section>}
@if(Model.Count==0){<div class="card p-5 text-center text-muted">ไม่มีรายการบัญชีในช่วงวันที่เลือก</div>}
<p class="small text-muted mt-4">โมดูลนี้เป็นบัญชีย่อยการขาย ไม่รวมยอดยกมา จัดซื้อ เจ้าหนี้ หรือการรับรองงบการเงิน โดยจัด Token ที่ใช้ซื้อเป็นส่วนลดขายเพื่อการบริหาร และแยกภาษีตามค่าที่บันทึกในคำสั่งซื้อ</p>

