@model CatalogModel
@{ ViewData["Title"] = "เลือกซื้อสินค้า"; }
<div class="page-heading"><div><p class="eyebrow">NATURE · WELLNESS · EVERY DAY</p><h1>ผลิตภัณฑ์ AM HERB</h1><p class="text-muted">สุขภาพที่ดี เริ่มจากการดูแลตัวเองทุกวัน</p></div><a class="btn btn-outline-success" href="/Cart">ตะกร้าสินค้า →</a></div>
<form method="get" class="search-bar mb-4"><input name="q" value="@Model.Search" class="form-control" placeholder="ค้นหาชื่อสินค้า หมวดหมู่ หรือ SKU" aria-label="ค้นหาสินค้า" /><button class="btn btn-success">ค้นหา</button></form>
<div class="row g-4">
@foreach (var p in Model.Items)
{
    <div class="col-md-6 col-xl-4"><article class="card product-card health-product-card h-100">
    <a class="product-visual" href="/Catalog/Detail/@p.Id">@if (!string.IsNullOrWhiteSpace(p.ImageUrl)) { <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" /> } else { <div class="product-monogram"><span>AM</span><small>HERB</small></div> }</a>
    <div class="card-body"><div class="small text-muted mb-2">@p.Category</div><h2 class="h5"><a class="text-decoration-none text-dark" href="/Catalog/Detail/@p.Id">@p.Name</a></h2><p class="small text-muted">@p.Variant · @p.Code</p>
    <div class="d-flex justify-content-between align-items-center"><strong class="price">฿@p.Price.ToString("N2")</strong><span class="badge text-bg-light">@p.BaseToken.ToString("N0") Base Token</span></div>
    <a class="btn btn-outline-success w-100 mt-3" href="/Catalog/Detail/@p.Id">ดูรายละเอียดผลิตภัณฑ์ ↗</a><form method="post" asp-controller="Cart" asp-action="Add" class="mt-3"><input type="hidden" name="skuId" value="@p.Id" /><button class="btn btn-success w-100" disabled="@(p.Stock <= 0)">@(p.Stock > 0 ? "เพิ่มลงตะกร้า" : "สินค้าหมด")</button></form>
    </div></article></div>
}
</div>
@if (Model.Items.Count == 0) { <div class="empty-state">ไม่พบสินค้า ลองค้นหาด้วยคำอื่น</div> }

