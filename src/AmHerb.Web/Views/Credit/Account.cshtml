@model CreditAccountModel
@{ViewData["Title"]="บัญชีเครดิต · "+Model.Account.Member.Name;var a=Model.Account;var overdue=Model.Invoices.Where(x=>x.DueAt<Model.Now).Sum(x=>x.Balance);string Status(CreditReceiptStatus s)=>s switch{CreditReceiptStatus.Confirmed=>"ยืนยันแล้ว",CreditReceiptStatus.Rejected=>"ไม่ผ่าน",_=>"รอตรวจสอบ"};}
<div class="page-heading"><div><p class="eyebrow">CREDIT ACCOUNT · @a.Member.Code</p><h1>@a.Member.Name</h1><p>@(a.MasterDealer?"มาสเตอร์ดีลเลอร์":"สมาชิกที่ได้รับสิทธิ์เครดิต") · @a.TermDays วัน · @(a.Enabled?"เปิดสิทธิ์เครดิต":"ระงับการซื้อเพิ่ม")</p></div><div class="d-flex gap-2 flex-wrap no-print"><a href="/Credit" class="btn btn-outline-success">บัญชีเครดิต</a><a href="/Credit/Statement/@a.Id" class="btn btn-outline-success">ใบแจ้งยอด</a><button class="btn btn-success" data-print>พิมพ์รายงาน</button></div></div>
<div class="stock-metrics"><div class="metric-card"><span>วงเงินอนุมัติ</span><strong>@a.Limit.ToString("N2")</strong></div><div class="metric-card"><span>หนี้คงค้าง</span><strong>@Model.Outstanding.ToString("N2")</strong></div><div class="metric-card stock-primary"><span>วงเงินคงเหลือ</span><strong>@Math.Max(0,a.Limit-Model.Outstanding).ToString("N2")</strong></div><div class="metric-card"><span>หนี้เกินกำหนด</span><strong class="text-danger">@overdue.ToString("N2")</strong></div></div>
@if(overdue>0){<div class="alert alert-warning">มีหนี้เกินกำหนด ระบบจะหยุดการซื้อด้วยเครดิตเพิ่มจนชำระหนี้ที่ค้างครบ</div>}
<section class="card p-4 mb-4 no-print"><h2 class="h4">แจ้งโอนชำระหนี้เครดิต</h2><div class="alert alert-light border">@ViewBag.BankInstructions</div><p class="text-muted">ตัดบิลที่ครบกำหนดก่อน รองรับจ่ายบางส่วน วงเงินคืนหลังฝ่ายการเงินตรวจสอบยอดเข้าบัญชีแล้วเท่านั้น</p><form asp-action="Submit" method="post" enctype="multipart/form-data" class="row g-3"><input type="hidden" name="accountId" value="@a.Id"/><input type="hidden" name="key" value="@Guid.NewGuid()"/><div class="col-md-4"><label for="repay-amount">ยอดโอน (บาท)</label><input id="repay-amount" name="amount" type="number" step="0.01" min="0.01" max="@Model.Outstanding" class="form-control" required/></div><div class="col-md-4"><label for="repay-time">วันเวลาโอน (เวลาไทย)</label><input id="repay-time" name="transferred" type="datetime-local" value="@Model.Now.AddHours(7).ToString("yyyy-MM-ddTHH:mm")" class="form-control" required/></div><div class="col-md-4"><label for="repay-ref">เลขอ้างอิงธนาคาร</label><input id="repay-ref" name="reference" maxlength="200" class="form-control" required/></div><div class="col-md-6"><label for="repay-slip">แนบสลิป (JPEG / PNG / WebP ≤ 5 MB)</label><input id="repay-slip" name="slip" type="file" accept="image/jpeg,image/png,image/webp" class="form-control"/></div><div class="col-md-6"><label for="repay-note">หมายเหตุ</label><input id="repay-note" name="note" maxlength="1000" class="form-control"/></div><div><button class="btn btn-success" disabled="@(Model.Outstanding<=0)">แจ้งโอนชำระเครดิต</button></div></form></section>
<h2 class="h4">รายการซื้อเชื่อและอายุหนี้</h2><div class="card table-responsive mb-4"><table class="table mb-0"><thead><tr><th>คำสั่งซื้อ / วันที่</th><th>ครบกำหนด</th><th>ยอดซื้อเชื่อ</th><th>ชำระแล้ว</th><th>ลดหนี้จากคืนสินค้า</th><th>คงค้าง</th><th>อายุหนี้</th></tr></thead><tbody>@foreach(var i in Model.Invoices){var days=Math.Max(0,(Model.Now.AddHours(7).Date-i.DueAt.AddHours(7).Date).Days);<tr><td><a href="/Orders/Detail/@i.Order.PublicId">@i.Order.Number</a><br/><small>@Bangkok.Format(i.IssuedAt)</small></td><td>@Bangkok.Format(i.DueAt)</td><td>@i.Amount.ToString("N2")</td><td>@i.Paid.ToString("N2")</td><td>@i.Adjusted.ToString("N2")</td><td>@i.Balance.ToString("N2")</td><td>@(i.Balance==0?"ปิดหนี้แล้ว":days==0?"ยังไม่เกินกำหนด":days<=30?"เกิน 1–30 วัน":days<=60?"เกิน 31–60 วัน":days<=90?"เกิน 61–90 วัน":"เกิน 90 วัน")</td></tr>}</tbody></table></div>
<h2 class="h4">รายการแจ้งโอนและผลตรวจสอบ</h2>@foreach(var r in Model.Receipts){<section class="card p-4 mb-3"><div class="d-flex justify-content-between flex-wrap gap-2"><div><a href="/Credit/Receipt/@r.Id">RC-@r.Id.ToString("D8")</a> · ฿@r.Amount.ToString("N2")<br/><small>@Bangkok.Format(r.TransferredAt) · @r.Reference</small></div><span class="badge align-self-start">@Status(r.Status)</span></div><p class="mb-1">@r.Note</p>@if(r.HasSlip){<a href="/Credit/Slip/@r.Id" target="_blank" rel="noopener" class="no-print">ดูสลิปโอนเงิน ↗</a>}<p class="text-muted mb-0">@r.ReviewNote</p>@if(Model.Finance&&r.Status==CreditReceiptStatus.Pending){<form asp-action="Review" method="post" class="d-flex flex-wrap gap-2 mt-3 no-print"><input type="hidden" name="id" value="@r.Id"/><input name="reason" aria-label="ผลตรวจสอบโอน" class="form-control" placeholder="ผลตรวจสอบยอดเข้าบัญชี / เหตุผลปฏิเสธ" required maxlength="1000"/><button name="approve" value="true" class="btn btn-success">ยืนยันรับโอนและคืนวงเงิน</button><button name="approve" value="false" class="btn btn-outline-danger">ไม่อนุมัติ</button></form>}</section>}
@if(Model.Finance){<details class="card p-4 mt-4 no-print"><summary>แก้ไขวงเงินและสิทธิ์</summary><form asp-action="Configure" method="post" class="row g-3 mt-2"><input type="hidden" name="code" value="@a.Member.Code"/><input type="hidden" name="version" value="@Convert.ToBase64String(a.RowVersion)"/><div class="col-md-6"><label for="edit-limit">วงเงิน (บาท)</label><input id="edit-limit" name="limit" value="@a.Limit" class="form-control" type="number" min="0" max="100000000" step="0.01" required/></div><div class="col-md-6"><label for="edit-days">เครดิต (วัน)</label><input id="edit-days" name="days" value="@a.TermDays" class="form-control" type="number" min="1" max="365" required/></div><div class="col-12 d-flex flex-wrap gap-4"><label><input name="enabled" value="true" type="checkbox" checked="@a.Enabled"/> เปิดสิทธิ์ซื้อด้วยเครดิต</label><label><input name="master" value="true" type="checkbox" checked="@a.MasterDealer"/> มาสเตอร์ดีลเลอร์</label></div><div class="col-12"><label for="edit-reason">เหตุผล / เลขที่อนุมัติ</label><input id="edit-reason" name="reason" class="form-control" required maxlength="1000"/></div><div><button class="btn btn-success">บันทึกวงเงิน</button></div></form></details>}

