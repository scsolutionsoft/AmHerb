@model StockTransfer
@using AmHerb.Web.Controllers
@using System.Security.Claims
@{ ViewData["Title"] = "ใบเบิก TR-" + Model.Id.ToString("D8"); var manager = StockTransferService.Manager(User); var uid = User.FindFirstValue(ClaimTypes.NameIdentifier); var owner = Model.DestinationWarehouse.OwnerMember?.UserId == uid && Model.DestinationWarehouse.OwnerMember?.Status == MemberStatus.Active; }
<div class="page-heading"><div><p class="eyebrow">WAREHOUSE TRANSFER</p><h1>@ViewData["Title"]</h1><p>@TransferPage.Label(Model.Status) · สร้าง @Bangkok.Format(Model.CreatedAt)</p></div><div class="d-flex gap-2 no-print"><a class="btn btn-outline-success" href="/Transfers">รายการใบเบิก</a><button class="btn btn-success" data-print>พิมพ์ใบเบิก / ใบส่งของ</button></div></div>
<section class="card p-4 mb-4"><div class="row g-4"><div class="col-md-5"><p class="text-muted mb-1">คลังต้นทาง</p><h2 class="h4">@Model.SourceWarehouse.Name</h2></div><div class="col-md-5"><p class="text-muted mb-1">คลังปลายทาง</p><h2 class="h4">@Model.DestinationWarehouse.Name</h2></div><div class="col-md-2"><p class="text-muted mb-1">จำนวน</p><strong class="fs-3">@Model.Quantity.ToString("N0")</strong> ชิ้น</div></div><hr /><h2 class="h5">@Model.Sku.Product.Name · @Model.Sku.Code</h2><p class="mb-1">เหตุผล: @Model.Reason</p>@if(Model.DispatchedAt != null){<p class="mb-1">จ่ายสินค้า: @Bangkok.Format(Model.DispatchedAt.Value) · อ้างอิง @Model.Tracking</p>}@if(Model.ReceivedAt != null){<p class="mb-1">รับสินค้า: @Bangkok.Format(Model.ReceivedAt.Value)</p>}<p class="small text-muted mb-0 mt-2">เอกสารโอนย้ายสต๊อก ไม่ใช่ใบเสร็จรับเงิน · ไม่มีการให้ Token จากรายการนี้</p></section>
@if(Model.Allocations.Count>0){<div class="card table-responsive mb-4"><table class="table mb-0"><thead><tr><th>ล็อตที่จ่าย</th><th>วันผลิต</th><th>วันหมดอายุ</th><th class="text-end">จำนวนชิ้น</th></tr></thead><tbody>@foreach(var a in Model.Allocations){<tr><td>@a.SourceBatch.LotNo</td><td>@a.SourceBatch.MfgDate.ToString("dd/MM/yyyy")</td><td>@a.SourceBatch.ExpDate.ToString("dd/MM/yyyy")</td><td class="text-end">@a.Quantity</td></tr>}</tbody></table></div>}
@if(Model.Status == TransferStatus.Requested && manager){<section class="card p-4 mb-3 no-print"><h2 class="h4">อนุมัติและจ่ายสินค้า</h2><p class="text-muted">ระบบเลือกลอตที่หมดอายุก่อน ตัดเฉพาะยอดพร้อมขาย และบันทึกเป็นสินค้าระหว่างขนส่ง</p><form asp-action="Dispatch" method="post" class="row g-3"><input type="hidden" name="id" value="@Model.Id" /><div class="col-md-6"><label for="dispatch-tracking">เลขส่งของ / อ้างอิงการส่งมอบ</label><input class="form-control" id="dispatch-tracking" name="tracking" maxlength="200" required /></div><div class="col-md-6"><label for="dispatch-reason">หมายเหตุการอนุมัติ</label><input class="form-control" id="dispatch-reason" name="reason" maxlength="900" required /></div><div class="col-12"><button class="btn btn-success">อนุมัติและจ่ายสินค้า</button></div></form></section>}
@if(Model.Status == TransferStatus.Dispatched && (owner || manager)){<section class="card p-4 mb-3 no-print"><h2 class="h4">ยืนยันรับสินค้าครบจำนวน</h2><p>ตรวจสอบ @Model.Quantity ชิ้น และล็อตตามใบส่งของก่อนยืนยัน หากสินค้าขาดหรือเสียหาย ให้ติดต่อผู้ดูแลก่อนรับเข้า</p><form asp-action="Receive" method="post"><input type="hidden" name="id" value="@Model.Id" /><label for="receive-reason">ผลการตรวจรับ</label><input class="form-control mb-3" id="receive-reason" name="reason" maxlength="900" placeholder="ตรวจครบจำนวนและล็อตตรงตามใบส่งของ" required /><button class="btn btn-success">ยืนยันรับครบ @Model.Quantity ชิ้น</button></form></section>}
@if(Model.Status == TransferStatus.Requested && (manager || (owner && Model.RequestedBy == uid))){<details class="card p-4 no-print"><summary>ยกเลิก / ไม่อนุมัติใบเบิก</summary><form asp-action="Cancel" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Id" /><label for="cancel-reason">เหตุผลการยกเลิก</label><input class="form-control mb-3" id="cancel-reason" name="reason" maxlength="900" required /><button class="btn btn-outline-danger">ยกเลิกใบเบิก</button></form></details>}


