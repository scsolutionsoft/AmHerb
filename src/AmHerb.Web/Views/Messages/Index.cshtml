@model List<Conversation>
@using AmHerb.Web.Controllers
@using System.Security.Claims
@{ViewData["Title"]="ศูนย์ข้อความ";var staff=(bool)ViewBag.Staff;var uid=User.FindFirstValue(ClaimTypes.NameIdentifier);var members=(List<Member>)ViewBag.Members;}
<div class="page-heading"><div><p class="eyebrow">MEMBER MESSAGING</p><h1>ศูนย์ข้อความ</h1><p>พูดคุยกับสมาชิกหรือทีมดูแล พร้อมส่งรูปและเอกสารอย่างปลอดภัย</p></div></div>
<details class="card p-4 mb-4" open><summary class="fw-bold">+ สร้างข้อความใหม่</summary><form asp-action="Send" method="post" enctype="multipart/form-data" class="mt-3"><input type="hidden" name="key" value="@Guid.NewGuid()"/>@if(staff){<label for="chat-member">สมาชิกผู้รับ</label><select class="form-select mb-3" id="chat-member" name="memberId" required>@foreach(var m in members){<option value="@m.Id">@m.Code · @m.Name</option>}</select>}else{<label for="chat-recipient">ส่งถึง</label><select class="form-select mb-3" id="chat-recipient" name="recipientMemberId"><option value="">ทีมดูแลสมาชิก AM HERB</option>@foreach(var m in members){<option value="@m.Id">@m.Code · @m.Name</option>}</select>}<label for="chat-subject">หัวข้อ</label><input class="form-control mb-3" id="chat-subject" name="subject" maxlength="180" required/><label for="chat-body">ข้อความ</label><textarea class="form-control mb-3" id="chat-body" name="body" rows="4" maxlength="4000" placeholder="พิมพ์ข้อความ หรือแนบไฟล์อย่างน้อยหนึ่งอย่าง"></textarea><label for="chat-file">ไฟล์แนบ (ไม่เกิน 8 MB)</label><input class="form-control mb-3" id="chat-file" type="file" name="attachment" accept="image/jpeg,image/png,image/webp,application/pdf,text/plain,.docx,.xlsx"/><div class="small text-muted mb-3">รองรับ JPEG, PNG, WebP, PDF, TXT, DOCX และ XLSX</div><button class="btn btn-success">ส่งข้อความ</button></form></details>
<div class="row g-3">@foreach(var c in Model){var counterpart=c.OtherMember==null?"AM HERB Member Care":(c.Member.UserId==uid?c.OtherMember.Name:c.Member.Name);<div class="col-md-6"><a class="card p-4 text-decoration-none h-100" asp-action="Detail" asp-route-id="@c.Id"><div class="d-flex justify-content-between gap-2"><strong>@c.Subject</strong><span class="badge">@MessagesController.Label(c.Status)</span></div><span class="small text-muted mt-2">@(staff?c.Member.Name:counterpart) · @Bangkok.Format(c.UpdatedAt)</span></a></div>}@if(Model.Count==0){<p class="text-muted">ยังไม่มีการสนทนา เริ่มส่งข้อความได้จากแบบฟอร์มด้านบน</p>}</div>
