@model OperationsOrders
@{ ViewData["Title"] = "ตรวจออเดอร์และจัดส่ง";
 string PageUrl(int page) => Url.Action("Orders", new { origin = Model.Origin, relation = Model.Relation, memberCode = Model.MemberCode, q = Model.Q, status = Model.Status, payment = Model.Payment, shipping = Model.Shipping, from = Model.From.ToString("yyyy-MM-dd"), to = Model.To.ToString("yyyy-MM-dd"), page })!;
}
<h1>ตรวจออเดอร์และจัดส่ง</h1><partial name="_OperationsNav" />
<form method="get" class="card p-3 mb-3"><div class="row g-3"><div class="col-md-4"><label class="form-label" for="origin">แหล่งขาย</label><select id="origin" name="origin" class="form-select">@foreach(var option in OperationsOrders.Origins) { <option value="@option.Key" selected="@(option.Key == Model.Origin)">@option.Value</option> }</select></div><div class="col-md-4"><label for="memberCode" class="form-label">รหัสสมาชิกที่ต้องการตรวจ</label><input id="memberCode" name="memberCode" value="@Model.MemberCode" class="form-control" placeholder="AM… (เว้นว่างเพื่อดูทั้งหมด)" /></div><div class="col-md-4"><label for="relation" class="form-label">ความเกี่ยวข้องกับสมาชิก</label><select id="relation" name="relation" class="form-select">@foreach(var option in OperationsOrders.Relations) { <option value="@option.Key" selected="@(option.Key == Model.Relation)">@option.Value</option> }</select></div>
<div class="col-md-4"><label for="q" class="form-label">เลขออเดอร์ / ลูกค้า / ร้าน</label><input id="q" name="q" value="@Model.Q" class="form-control" /></div><div class="col-md-4"><label for="status" class="form-label">สถานะออเดอร์</label><select id="status" name="status" class="form-select"><option value="">ทุกสถานะ</option>@foreach(var s in Enum.GetValues<OrderStatus>()) { <option selected="@(s == Model.Status)" value="@s">@MemberLabels.Order(s)</option> }</select></div><div class="col-md-4"><label for="payment" class="form-label">การชำระ</label><select id="payment" name="payment" class="form-select"><option value="">ทั้งหมด</option>@foreach(var s in new[] { "Pending", "Submitted", "Confirmed", "CreditApproved" }) { <option selected="@(s == Model.Payment)" value="@s">@MemberLabels.Payment(s)</option> }</select></div>
<div class="col-md-4"><label for="from" class="form-label">วันที่ออเดอร์เริ่ม (เวลาไทย)</label><input id="from" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-4"><label for="to" class="form-label">ถึงวันที่</label><input id="to" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-4 align-self-end"><label class="d-block mb-2"><input type="checkbox" name="shipping" value="true" checked="@Model.Shipping" /> เฉพาะงานเตรียม / กำลังจัดส่ง</label><button class="btn btn-success">กรองรายการ</button> <a href="/Operations/Orders">ล้างตัวกรอง</a></div></div></form>
<p class="small text-muted">แหล่งขายแยกจากผู้แนะนำ: ออเดอร์ส่วนกลางอาจมีผู้แนะนำเป็นสมาชิกได้ · POS แยกตามคลังล็อตที่ตัดสินค้า · สายงานใช้โครงสร้างปัจจุบัน ส่วนประวัติ Token ใช้ผู้ได้รับจริงในออเดอร์เดิม</p>
@if(Model.Member != null) { <p>กำลังตรวจ <a href="/Operations/Member/@Model.Member.Id">@Model.Member.Code · @Model.Member.Name</a></p> }
<partial name="_LiveStatus" /><div data-live-region="operations-orders"><div class="alert alert-light"><strong>@Model.Total.ToString("N0") ออเดอร์</strong> · ยอดชำระตามรายการ @Model.Payable.ToString("N2") บาท <small>(รวมทุกสถานะที่กรอง ไม่ใช่ยอดรับเงินจริงหรือยอดขายสุทธิ)</small></div>
@foreach(var o in Model.Orders) { var payment = Model.Payments.GetValueOrDefault(o.Id); var cashier = o.CashierUserId == null ? null : Model.Cashiers.GetValueOrDefault(o.CashierUserId);
<article class="card p-4 mb-3" style="overflow-wrap:anywhere;min-width:0"><div class="d-flex flex-wrap justify-content-between gap-2"><h2 class="h5" style="min-width:0;max-width:100%"><a href="/Orders/Detail/@o.PublicId">@o.Number → รายละเอียด / สลิป</a></h2><span>@MemberLabels.Order(o.Status)</span></div><p class="small text-muted">@OperationsQueries.OriginLabel(o) · @o.Channel · @Bangkok.Format(o.CreatedAt)</p><div class="row g-2"><div class="col-lg-7"><p class="mb-1">ร้าน: @(o.Store?.Name ?? "AM HERB ส่วนกลาง")</p>@if(o.Store != null) { <p class="mb-1">เจ้าของร้าน: <a href="/Operations/Member/@o.Store.MemberId">@o.Store.Member.Code · @o.Store.Member.Name</a></p> }<p class="mb-1">ผู้ซื้อ: @o.CustomerName @if(o.Buyer != null) { <span>· @o.Buyer.Code</span> }</p><p class="mb-1">ผู้แนะนำ: @if(o.Seller != null) { <a href="/Operations/Member/@o.Seller.Id">@o.Seller.Code · @o.Seller.Name</a> } else { <span>ไม่มี</span> }</p>@if(cashier != null) { <p class="mb-1">แคชเชียร์: <a href="/Operations/Member/@cashier.Id">@cashier.Code · @cashier.Name</a></p> }<p class="small">คลังต้นทาง: @string.Join(", ", o.Items.SelectMany(x => x.Allocations).Select(x => x.InventoryBatch.Warehouse.Name).Distinct())</p></div><div class="col-lg-5"><strong>@o.CashPayable.ToString("N2") บาท</strong><p>@(payment == null ? "ยังไม่มีรายการชำระ" : MemberLabels.Payment(payment.Status)) · @payment?.Provider</p><p>Token ใช้แลก @o.TokenRedemption.ToString("N2")</p></div></div>
@if(o.Channel != SalesChannel.POS) { <p>@o.Address · โทร @o.Phone</p><p>ขนส่งที่เลือก: @o.SelectedCarrier</p><a class="btn btn-outline-success align-self-start mb-3" href="/Operations/Label/@o.Id">พิมพ์ใบปะหน้า A5</a> }
@foreach(var shipment in Model.Shipments.Where(x => x.OrderId == o.Id)) { <p class="alert alert-success">@shipment.Carrier · @shipment.TrackingNumber · @(shipment.Status == "Delivered" ? "ส่งมอบแล้ว" : "กำลังจัดส่ง")</p> }
@if(o.Channel != SalesChannel.POS && o.Status == OrderStatus.Paid) { <form asp-action="Prepare" method="post" class="mb-3"><input type="hidden" name="id" value="@o.Id" /><button class="btn btn-outline-success">เริ่มเตรียมสินค้า</button></form> }
@if(o.Channel != SalesChannel.POS && o.Status is OrderStatus.Paid or OrderStatus.Processing) { <details><summary>บันทึกการจัดส่ง</summary><form asp-action="Ship" method="post" class="row g-2 mt-2"><input type="hidden" name="id" value="@o.Id" /><div class="col-md-4"><label for="carrier-@o.Id">ผู้ขนส่งจริง</label><input id="carrier-@o.Id" name="carrier" value="@o.SelectedCarrier" required maxlength="120" class="form-control" /></div><div class="col-md-4"><label for="tracking-@o.Id">เลขพัสดุ</label><input id="tracking-@o.Id" name="tracking" required maxlength="120" class="form-control" /></div><div class="col-md-4"><label for="reason-@o.Id">หมายเหตุ / เหตุผล</label><input id="reason-@o.Id" name="reason" required maxlength="1000" class="form-control" /></div><div><button class="btn btn-success">บันทึกส่งสินค้า</button></div></form></details> }
@if(o.Channel != SalesChannel.POS && o.Status == OrderStatus.Shipped) { <form asp-action="Ship" method="post" class="d-flex flex-wrap gap-2"><input type="hidden" name="id" value="@o.Id" /><input type="hidden" name="delivered" value="true" /><input name="reason" aria-label="หลักฐานส่งมอบ" placeholder="หมายเหตุ / หลักฐานส่งมอบ" required maxlength="1000" class="form-control" /><button class="btn btn-success">ยืนยันส่งมอบแล้ว</button></form> }
</article> }
@if(Model.Total == 0) { <p class="alert alert-info">ไม่พบออเดอร์ตรงกับตัวกรอง</p> }
<nav class="d-flex gap-3">@if(Model.Page > 1) { <a href="@PageUrl(Model.Page - 1)">← ก่อนหน้า</a> }<span>หน้า @Model.Page</span>@if(Model.Page * 50 < Model.Total) { <a href="@PageUrl(Model.Page + 1)">ถัดไป →</a> }</nav></div>
@section Scripts { <script src="~/js/member-live.js" asp-append-version="true"></script> }
