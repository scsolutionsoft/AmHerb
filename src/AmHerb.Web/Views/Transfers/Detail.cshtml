@model StockTransfer
@using AmHerb.Web.Controllers
@using System.Security.Claims
@{ ViewData["Title"] = string.IsNullOrWhiteSpace(Model.PoNumber) ? "ใบเบิก TR-" + Model.Id.ToString("D8") : Model.PoNumber; var manager = StockTransferService.Manager(User); var finance = (bool)(ViewBag.Finance ?? false); var uid = User.FindFirstValue(ClaimTypes.NameIdentifier); var owner = Model.DestinationWarehouse.OwnerMember?.UserId == uid && Model.DestinationWarehouse.OwnerMember?.Status == MemberStatus.Active; var financialLabel = Model.FinancialStatus switch { TransferFinancialStatus.AwaitingPayment => "รอชำระเงิน", TransferFinancialStatus.Submitted => "ส่งหลักฐานแล้ว", TransferFinancialStatus.CreditReview => "รออนุมัติเครดิต", TransferFinancialStatus.Approved => "อนุมัติเครดิต", TransferFinancialStatus.Paid => "ชำระครบแล้ว", TransferFinancialStatus.Rejected => "หลักฐานไม่ผ่าน", TransferFinancialStatus.Waived => "ไม่เรียกเก็บ", _ => "ยกเลิก" }; var methodLabel = Model.PaymentMethod switch { TransferPaymentMethod.BankTransfer => "โอนเงิน", TransferPaymentMethod.Cash => "เงินสด", TransferPaymentMethod.MemberCredit => "เครดิตสมาชิก", _ => "ไม่เรียกเก็บ" }; }
<div class="page-heading"><div><p class="eyebrow">PURCHASE & STOCK TRANSFER</p><h1>@ViewData["Title"]</h1><p>@financialLabel · @TransferPage.Label(Model.Status) · สร้าง @Bangkok.Format(Model.CreatedAt)</p></div><div class="d-flex flex-wrap gap-2 no-print"><a class="btn btn-outline-success" href="/Transfers">รายการ PO</a><a class="btn btn-success" asp-action="Document" asp-route-id="@Model.Id" asp-route-type="po" target="_blank">พิมพ์ PO</a>@if(Model.DispatchedAt != null){<a class="btn btn-outline-success" asp-action="Document" asp-route-id="@Model.Id" asp-route-type="dispatch" target="_blank">ใบส่งของ</a>}@if(Model.ReceivedAt != null){<a class="btn btn-outline-success" asp-action="Document" asp-route-id="@Model.Id" asp-route-type="receipt" target="_blank">ใบรับสินค้า</a>}</div></div>
<section class="card p-4 mb-4"><div class="row g-4"><div class="col-md-4"><p class="text-muted mb-1">คลังต้นทาง</p><h2 class="h4">@Model.SourceWarehouse.Name</h2></div><div class="col-md-4"><p class="text-muted mb-1">คลังปลายทาง</p><h2 class="h4">@Model.DestinationWarehouse.Name</h2></div><div class="col-md-2"><p class="text-muted mb-1">จำนวน</p><strong class="fs-3">@Model.Quantity.ToString("N0")</strong> ชิ้น</div><div class="col-md-2"><p class="text-muted mb-1">ยอด PO</p><strong class="fs-4">@Model.ChargeAmount.ToString("N2")</strong> บาท</div></div><hr /><h2 class="h5">@Model.Sku.Product.Name · @Model.Sku.Code</h2><p class="mb-1">เหตุผล: @Model.Reason</p>@if(Model.DispatchedAt != null){<p class="mb-1">จ่ายสินค้า: @Bangkok.Format(Model.DispatchedAt.Value) · อ้างอิง @Model.Tracking</p>}@if(Model.ReceivedAt != null){<p class="mb-1">รับสินค้า: @Bangkok.Format(Model.ReceivedAt.Value)</p>}<p class="small text-muted mb-0 mt-2">เอกสารโอนย้ายสต๊อกและ PO ไม่สร้างรางวัล Token</p></section>
<section class="card p-4 mb-4"><div class="d-flex flex-wrap justify-content-between gap-3"><div><p class="eyebrow mb-1">FINANCIAL CLEARANCE</p><h2 class="h4 mb-1">@methodLabel · @financialLabel</h2><p class="text-muted mb-0">ราคา @Model.PriceTier · @Model.UnitPrice.ToString("N2") บาท/ชิ้น · รับเงินแล้ว @Model.PaidAmount.ToString("N2") / @Model.ChargeAmount.ToString("N2") บาท</p>@if(Model.DueAt != null){<p class="mb-0">ครบกำหนด @Bangkok.Format(Model.DueAt.Value)</p>}</div><a asp-action="Document" asp-route-id="@Model.Id" asp-route-type="po" target="_blank">ตรวจเอกสาร PO →</a></div>
@if((owner || manager) && Model.Status == TransferStatus.Requested && Model.PaymentMethod is TransferPaymentMethod.BankTransfer or TransferPaymentMethod.MemberCredit && Model.FinancialStatus != TransferFinancialStatus.Paid){<hr /><form asp-action="SubmitPayment" method="post" enctype="multipart/form-data" class="row g-3"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="key" value="@Guid.NewGuid()" /><div class="col-md-3"><label>ยอดแจ้งชำระ</label><input class="form-control" name="amount" type="number" step="0.01" min="0.01" max="@(Model.ChargeAmount-Model.PaidAmount)" value="@((Model.ChargeAmount-Model.PaidAmount).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" required /></div><div class="col-md-3"><label>วันเวลาที่ชำระ</label><input class="form-control" name="paidAt" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required /></div><div class="col-md-3"><label>เลขอ้างอิง</label><input class="form-control" name="reference" maxlength="200" required /></div><div class="col-md-3"><label>สลิปโอนเงิน</label><input class="form-control" name="slip" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" required /></div><div class="col-12"><label>หมายเหตุ</label><input class="form-control" name="note" maxlength="900" value="ชำระตาม @Model.PoNumber" required /></div><div class="col-12"><button class="btn btn-success">ส่งหลักฐานให้ฝ่ายการเงินตรวจ</button></div></form>}
@if(finance && Model.Status == TransferStatus.Requested && Model.PaymentMethod is TransferPaymentMethod.Cash or TransferPaymentMethod.MemberCredit && Model.FinancialStatus is TransferFinancialStatus.AwaitingPayment or TransferFinancialStatus.CreditReview){<hr /><form asp-action="ApproveFinancial" method="post" class="row g-3"><input type="hidden" name="id" value="@Model.Id" /><div class="col-md-4"><label>เลขอ้างอิงรับเงิน/อนุมัติเครดิต</label><input class="form-control" name="reference" maxlength="200" required /></div>@if(Model.PaymentMethod == TransferPaymentMethod.MemberCredit){<div class="col-md-4"><label>วันครบกำหนด (เว้นว่างใช้เงื่อนไขบัญชี)</label><input class="form-control" name="dueAt" type="datetime-local" /></div>}<div class="col-md-4"><label>เหตุผลอนุมัติ</label><input class="form-control" name="reason" maxlength="900" required /></div><div class="col-12"><button class="btn btn-success">ยืนยันด้านการเงิน</button></div></form>}
</section>
@if(Model.Payments.Count > 0){<section class="card table-responsive mb-4"><table class="table mb-0"><thead><tr><th>หลักฐาน</th><th>อ้างอิง / เวลา</th><th class="text-end">ยอด</th><th>สถานะ</th><th class="no-print">ตรวจสอบ</th></tr></thead><tbody>@foreach(var p in Model.Payments.OrderByDescending(x=>x.Id)){<tr><td><a asp-action="PaymentSlip" asp-route-id="@p.Id" target="_blank">ดูสลิป #@p.Id</a></td><td>@p.Reference<div class="small text-muted">@Bangkok.Format(p.PaidAt)</div></td><td class="text-end">@p.Amount.ToString("N2")</td><td>@p.Status@if(!string.IsNullOrWhiteSpace(p.ReviewNote)){<div class="small text-muted">@p.ReviewNote</div>}</td><td class="no-print">@if(finance && p.Status == TransferPaymentStatus.Submitted){<form asp-action="ReviewPayment" method="post" class="d-flex gap-2"><input type="hidden" name="paymentId" value="@p.Id" /><input class="form-control form-control-sm" name="reason" maxlength="900" placeholder="ผลการตรวจ" required /><button class="btn btn-sm btn-success" name="approve" value="true">ยืนยัน</button><button class="btn btn-sm btn-outline-danger" name="approve" value="false">ปฏิเสธ</button></form>}</td></tr>}</tbody></table></section>}
<div id="transfer-context" data-transfer-id="@Model.Id" data-quantity="@Model.Quantity" data-status="@Model.Status"></div><partial name="_TransferBalances" />
@if(Model.Allocations.Count>0){<div class="card table-responsive mb-4"><table class="table mb-0"><thead><tr><th>ล็อตที่จ่าย</th><th>วันผลิต</th><th>วันหมดอายุ</th><th class="text-end">จำนวนชิ้น</th></tr></thead><tbody>@foreach(var a in Model.Allocations){<tr><td>@a.SourceBatch.LotNo</td><td>@a.SourceBatch.MfgDate.ToString("dd/MM/yyyy")</td><td>@a.SourceBatch.ExpDate.ToString("dd/MM/yyyy")</td><td class="text-end">@a.Quantity</td></tr>}</tbody></table></div>}
@if(Model.Status == TransferStatus.Requested && manager){<section class="card p-4 mb-3 no-print"><h2 class="h4">อนุมัติและจ่ายสินค้า</h2><p class="text-muted">ทำได้เมื่อสถานะการเงินอนุมัติแล้ว ระบบเลือกลอตหมดอายุก่อนและบันทึกเป็นสินค้าระหว่างขนส่ง</p><form asp-action="Dispatch" data-transfer-form="dispatch" method="post" class="row g-3"><input type="hidden" name="id" value="@Model.Id" /><div class="col-md-6"><label for="dispatch-tracking">เลขส่งของ / อ้างอิงการส่งมอบ</label><input class="form-control" id="dispatch-tracking" name="tracking" maxlength="200" required /></div><div class="col-md-6"><label for="dispatch-reason">หมายเหตุการอนุมัติ</label><input class="form-control" id="dispatch-reason" name="reason" maxlength="900" required /></div><div class="col-12">@if(Model.FinancialStatus is TransferFinancialStatus.Paid or TransferFinancialStatus.Approved or TransferFinancialStatus.Waived){<button class="btn btn-success">อนุมัติและจ่ายสินค้า</button>}else{<button class="btn btn-success" disabled>รอฝ่ายการเงินอนุมัติ</button>}</div></form></section>}
@if(Model.Status == TransferStatus.Dispatched && (owner || manager)){<section class="card p-4 mb-3 no-print"><h2 class="h4">ยืนยันรับสินค้าครบจำนวน</h2><p>ตรวจสอบ @Model.Quantity ชิ้นและล็อตตามใบส่งของก่อนยืนยัน</p><form asp-action="Receive" data-transfer-form="receive" method="post"><input type="hidden" name="id" value="@Model.Id" /><label for="receive-reason">ผลการตรวจรับ</label><input class="form-control mb-3" id="receive-reason" name="reason" maxlength="900" placeholder="ตรวจครบจำนวนและล็อตตรงตามใบส่งของ" required /><button class="btn btn-success">ยืนยันรับครบ @Model.Quantity ชิ้น</button></form></section>}
@if(Model.Status == TransferStatus.Requested && (manager || (owner && Model.RequestedBy == uid))){<details class="card p-4 no-print"><summary>ยกเลิก / ไม่อนุมัติ PO</summary><form asp-action="Cancel" data-transfer-form="cancel" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Id" /><label for="cancel-reason">เหตุผลการยกเลิก</label><input class="form-control mb-3" id="cancel-reason" name="reason" maxlength="900" required /><button class="btn btn-outline-danger">ยกเลิก PO</button></form></details>}
<partial name="_TransferDialogs" />
@section Scripts { <script src="~/js/transfers.js" asp-append-version="true"></script> }
