@model List<OperationsMember>
@{ ViewData["Title"] = "Token รายสมาชิก"; }
<h1>Token รายสมาชิก</h1><partial name="_OperationsNav" /><form method="get" class="d-flex flex-wrap gap-2 mb-3"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="รหัส / ชื่อสมาชิก" aria-label="ค้นหาสมาชิก" /><label><input type="checkbox" name="negative" value="true" checked="@ViewBag.Negative" /> เฉพาะยอดพร้อมใช้ติดลบ</label><button class="btn btn-success">ค้นหา</button></form><p>@ViewBag.Total สมาชิก · ยอดคำนวณจากบัญชีรายการจริง</p><div class="card table-responsive"><table class="table"><thead><tr><th>สมาชิก</th><th>พร้อมใช้</th><th>รอปลดล็อก</th><th>จอง</th></tr></thead><tbody>@foreach(var m in Model) { <tr><td><a href="/Operations/Member/@m.Member.Id">@m.Member.Code · @m.Member.Name</a></td><td class="@(m.Available < 0 ? "text-danger" : "")">@m.Available.ToString("N2")</td><td>@m.Pending.ToString("N2")</td><td>@m.Reserved.ToString("N2")</td></tr> }@if(Model.Count == 0) { <tr><td colspan="4">ไม่พบสมาชิกตามตัวกรอง</td></tr> }</tbody></table></div><nav class="d-flex gap-3 my-3">@if(ViewBag.Page > 1) { <a asp-action="Tokens" asp-route-q="@ViewBag.Q" asp-route-negative="@ViewBag.Negative" asp-route-page="@(ViewBag.Page - 1)">ก่อนหน้า</a> }@if(ViewBag.Page * 50 < ViewBag.Total) { <a asp-action="Tokens" asp-route-q="@ViewBag.Q" asp-route-negative="@ViewBag.Negative" asp-route-page="@(ViewBag.Page + 1)">ถัดไป</a> }</nav><a href="/Admin?section=TokenPolicies">นโยบาย Token</a> · <a href="/Admin?section=Ledger">บัญชีรายการ / ปรับยอดพร้อมเหตุผล</a>
