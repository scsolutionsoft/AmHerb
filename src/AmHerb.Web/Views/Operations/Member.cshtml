@model OperationsMember
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{ ViewData["Title"] = "ตรวจสอบสมาชิก " + Model.Member.Code; var canOrders = (await Authorization.AuthorizeAsync(User, "Orders")).Succeeded; }
<h1 class="h3">@Model.Member.Name</h1><p>@Model.Member.Code · @Model.Member.Type · @MemberLabels.Member(Model.Member.Status)</p><partial name="_OperationsNav" />
@if(canOrders) { <section class="card p-4 mb-4"><h2 class="h5">ประวัติที่เกี่ยวข้องกับสมาชิก</h2><div class="d-flex flex-wrap gap-2">@foreach(var relation in OperationsOrders.Relations) { <a class="btn btn-outline-success" asp-action="Orders" asp-route-memberCode="@Model.Member.Code" asp-route-relation="@relation.Key">@relation.Value</a> }</div><p class="small text-muted mt-3 mb-0">ออเดอร์หนึ่งรายการอาจเกี่ยวข้องกับทั้งผู้ซื้อ ผู้แนะนำ และแคชเชียร์ จึงไม่ควรนำยอดจากแต่ละมุมมองมาบวกซ้ำกัน</p></section> }
@if(Model.Finance) { <section class="card p-4 mb-4"><h2 class="h5">บัญชีเครดิตสมาชิก</h2><p>หนี้คงค้าง <strong>@Model.Debt.ToString("N2") บาท</strong> · เกินกำหนด <strong>@Model.Overdue.ToString("N2") บาท</strong></p>@if(Model.Credit != null) { <a href="/Credit/Account/@Model.Credit.Id">ดูใบแจ้งหนี้ / ตรวจหลักฐานชำระ / ใบเสร็จ →</a> } else { <p class="mb-0">ยังไม่มีบัญชีเครดิต</p> }</section> }
@if(Model.Tokens) { <section class="card p-4 mb-4"><h2 class="h5">Token ของสมาชิก</h2><div class="row g-3"><div class="col-sm-4">พร้อมใช้ <strong>@Model.Available.ToString("N2")</strong></div><div class="col-sm-4">รอปลดล็อก <strong>@Model.Pending.ToString("N2")</strong></div><div class="col-sm-4">จอง <strong>@Model.Reserved.ToString("N2")</strong></div></div><p class="small text-muted mt-3">Token เป็นสิทธิ์แลกสินค้า แยกจากเงินค้างชำระ</p><details><summary>รายการ Token ล่าสุด 30 รายการ</summary><div class="table-responsive"><table class="table"><thead><tr><th>เวลา</th><th>ประเภท / ออเดอร์ต้นทาง</th><th>รอปลดล็อก</th><th>พร้อมใช้</th><th>จอง</th></tr></thead><tbody>@foreach(var l in Model.Ledger) { <tr><td>@Bangkok.Format(l.PostedAt)</td><td>@MemberLabels.Ledger(l.Kind) @if(l.SourceOrder != null && canOrders) { <br /><a href="/Orders/Detail/@l.SourceOrder.PublicId">@l.SourceOrder.Number</a> }<div class="small text-muted">@l.Reason</div></td><td>@l.PendingDelta.ToString("N2")</td><td>@l.AvailableDelta.ToString("N2")</td><td>@l.ReservedDelta.ToString("N2")</td></tr> }</tbody></table></div></details></section> }
<div class="row g-4"><section class="col-lg-5"><div class="card p-4"><h2 class="h5">อัพไลน์ปัจจุบัน</h2><p class="small text-muted">ชั้น 1 คือผู้แนะนำโดยตรง</p>@foreach(var n in Model.Upline) { <p>ชั้น @n.Depth · <a href="/Operations/Member/@n.Id">@n.Code · @n.Name</a></p> }@if(Model.Upline.Count == 0) { <p>ไม่มีผู้แนะนำ</p> }</div></section><section class="col-lg-7"><div class="card p-4"><h2 class="h5">ดาวน์ไลน์ปัจจุบัน @Model.DownlineTotal คน</h2><p class="small text-muted">ชั้น 1 คือผู้ที่แนะนำโดยตรง</p>@foreach(var n in Model.Downline) { <p>ชั้น @n.Depth · <a href="/Operations/Member/@n.Id">@n.Code · @n.Name</a></p> }@if(Model.DownlineTotal == 0) { <p>ยังไม่มีดาวน์ไลน์</p> }<nav class="d-flex gap-3">@if(Model.Page > 1) { <a asp-action="Member" asp-route-id="@Model.Member.Id" asp-route-page="@(Model.Page - 1)">ก่อนหน้า</a> }@if(Model.Page * 50 < Model.DownlineTotal) { <a asp-action="Member" asp-route-id="@Model.Member.Id" asp-route-page="@(Model.Page + 1)">ถัดไป</a> }</nav></div></section></div>
<p class="small text-muted mt-3">การย้ายสายงานเปลี่ยนมุมมองเครือข่ายปัจจุบัน ประวัติผู้ได้รับ Token ใช้รายการจัดสรรเดิมเพื่อตรวจย้อนหลัง</p>
