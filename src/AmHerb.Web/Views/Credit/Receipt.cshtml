@model CreditReceipt
@{ViewData["Title"]="เอกสารรับชำระเครดิต";var allocations=(List<CreditAllocation>)ViewBag.Allocations;}
<div class="page-heading"><div><p class="eyebrow">CREDIT PAYMENT</p><h1>@(Model.Status==CreditReceiptStatus.Confirmed?"หลักฐานรับชำระหนี้เครดิต":"ใบแจ้งโอนชำระเครดิต")</h1><p>RC-@Model.Id.ToString("D8") · @(Model.Status==CreditReceiptStatus.Confirmed?"ยืนยันรับเงินแล้ว":Model.Status==CreditReceiptStatus.Rejected?"ไม่อนุมัติ":"รอตรวจสอบ ยังไม่ใช่หลักฐานรับเงิน")</p></div><button class="btn btn-success no-print" data-print>ตัวอย่างก่อนพิมพ์ / PDF</button></div><section class="card p-4"><h2 class="h4">@Model.CreditAccount.Member.Name</h2><p>รหัสสมาชิก @Model.CreditAccount.Member.Code</p><dl class="row"><dt class="col-sm-4">ยอดโอน</dt><dd class="col-sm-8">฿@Model.Amount.ToString("N2")</dd><dt class="col-sm-4">วันเวลาโอน</dt><dd class="col-sm-8">@Bangkok.Format(Model.TransferredAt)</dd><dt class="col-sm-4">เลขอ้างอิงธนาคาร</dt><dd class="col-sm-8">@Model.Reference</dd><dt class="col-sm-4">วันที่ตรวจสอบ</dt><dd class="col-sm-8">@(Model.ReviewedAt==null?"—":Bangkok.Format(Model.ReviewedAt.Value))</dd></dl><p>@Model.Note</p><p>@Model.ReviewNote</p><h3 class="h5">การตัดชำระตามบิล</h3><div class="table-responsive"><table class="table"><thead><tr><th>คำสั่งซื้อ</th><th>ครบกำหนด</th><th>ยอดตัดชำระ</th></tr></thead><tbody>@foreach(var line in allocations){<tr><td>@line.CreditInvoice.Order.Number</td><td>@Bangkok.Format(line.CreditInvoice.DueAt)</td><td>@line.Amount.ToString("N2")</td></tr>}</tbody></table></div></section><a href="/Credit/Account/@Model.CreditAccountId" class="btn btn-outline-success mt-3 no-print">กลับบัญชีเครดิต</a>
