<div class="modal fade" id="stock-adjust-modal" tabindex="-1" aria-labelledby="stock-adjust-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 id="stock-adjust-title" class="modal-title h5">ปรับสต๊อกสินค้า</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button></div><div class="modal-body"><p id="stock-adjust-product" class="fw-bold"></p><p id="stock-adjust-location" class="small text-muted"></p><p id="stock-adjust-error" class="alert alert-warning" role="alert" hidden></p><button id="stock-adjust-reload" class="btn btn-outline-success btn-sm mb-3" type="button">โหลดข้อมูลล่าสุด</button>
<form id="stock-adjust-form" action="/Stock/Adjust" method="post">@Html.AntiForgeryToken()<input type="hidden" name="version" /><label for="stock-adjust-lot" class="form-label">ล็อตสินค้า</label><select id="stock-adjust-lot" name="batchId" class="form-select mb-3" required></select><div class="bg-light rounded p-3 mb-3" id="stock-adjust-balance" aria-live="polite"></div><label for="stock-adjust-kind" class="form-label">ประเภทการปรับ</label><select id="stock-adjust-kind" name="kind" class="form-select mb-3"><option value="Adjust">ปรับยอดจากการตรวจนับ</option><option value="Damage">ตัดสินค้าชำรุด</option><option value="Expire">ตัดสินค้าหมดอายุ</option></select><label for="stock-adjust-delta" class="form-label">จำนวนที่เพิ่มหรือลด (ชิ้น)</label><input id="stock-adjust-delta" name="delta" type="number" step="1" class="form-control" required /><p class="small text-muted">เพิ่ม 5 กรอก 5 · ลด 5 กรอก -5 · ไม่แก้จำนวนที่จองไว้ในออเดอร์</p><p id="stock-adjust-preview" aria-live="polite" class="fw-bold"></p><label for="stock-adjust-reason" class="form-label">เหตุผลการปรับ</label><textarea id="stock-adjust-reason" name="reason" maxlength="1000" rows="3" class="form-control mb-3" required></textarea><button id="stock-adjust-save" type="submit" class="btn btn-success w-100" disabled>บันทึกปรับสต๊อก</button></form></div></div></div></div>
