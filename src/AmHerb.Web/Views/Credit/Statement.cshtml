@model CreditStatement
@{ViewData["Title"]="ใบแจ้งยอดเครดิต";var balance=Model.Opening;var debit=Model.Entries.SelectMany(x=>x.Lines).Where(x=>x.Account=="1100").Sum(x=>x.Debit);var credit=Model.Entries.SelectMany(x=>x.Lines).Where(x=>x.Account=="1100").Sum(x=>x.Credit);}
<div class="page-heading"><div><p class="eyebrow">CUSTOMER STATEMENT</p><h1>ใบแจ้งยอดเครดิต</h1><p>@Model.Account.Member.Code · @Model.Account.Member.Name</p></div><button class="btn btn-success no-print" data-print>ตัวอย่างก่อนพิมพ์ / PDF</button></div>
<form method="get" class="card p-3 mb-4 d-flex flex-row flex-wrap gap-3 no-print"><div><label for="statement-from">ตั้งแต่ (เวลาไทย)</label><input id="statement-from" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control"/></div><div><label for="statement-to">ถึง</label><input id="statement-to" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control"/></div><button class="btn btn-success align-self-end">แสดงรายงาน</button><a href="/Credit/Account/@Model.Account.Id" class="btn btn-outline-success align-self-end">กลับบัญชี</a></form>
<p>ช่วงวันที่ @Model.From.ToString("dd/MM/yyyy") – @Model.To.ToString("dd/MM/yyyy") · หน่วย: บาท</p><div class="stock-metrics"><div class="metric-card"><span>ยอดยกมา</span><strong>@Model.Opening.ToString("N2")</strong></div><div class="metric-card"><span>เพิ่มหนี้ (เดบิต)</span><strong>@debit.ToString("N2")</strong></div><div class="metric-card"><span>ชำระ / ลดหนี้ (เครดิต)</span><strong>@credit.ToString("N2")</strong></div><div class="metric-card stock-primary"><span>ยอดคงเหลือสิ้นช่วง</span><strong>@((balance+debit-credit).ToString("N2"))</strong></div></div>
<div class="card table-responsive"><table class="table mb-0"><thead><tr><th>วันที่ลงบัญชี</th><th>รายการ</th><th>เดบิต</th><th>เครดิต</th><th>คงเหลือ</th></tr></thead><tbody><tr><td colspan="4">ยอดยกมา</td><td>@balance.ToString("N2")</td></tr>@foreach(var e in Model.Entries){var dr=e.Lines.Where(x=>x.Account=="1100").Sum(x=>x.Debit);var cr=e.Lines.Where(x=>x.Account=="1100").Sum(x=>x.Credit);balance+=dr-cr;<tr><td>@Bangkok.Format(e.PostedAt)</td><td>JV-@e.Id.ToString("D8") · @e.Description</td><td>@dr.ToString("N2")</td><td>@cr.ToString("N2")</td><td>@balance.ToString("N2")</td></tr>}</tbody></table></div><p class="text-muted small mt-3">ใบแจ้งยอดอิงวันที่ฝ่ายการเงินลงบัญชี ยอดโอนที่ยังรอตรวจสอบไม่หักออกจากหนี้</p>
