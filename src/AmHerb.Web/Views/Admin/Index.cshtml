@model AdminPage
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{ ViewData["Title"] = "จัดการ " + Model.Section; }
<div class="row g-4"><aside class="col-lg-2 no-print"><nav class="admin-nav card p-2" aria-label="เมนูผู้ดูแล"><span class="eyebrow px-2 py-3">BACK OFFICE</span>
@foreach (var item in new[] { ("Dashboard", "ภาพรวม", "Reports"), ("Members", "สมาชิก", "Members"), ("Tree", "สายงาน", "Members"), ("Products", "สินค้า", "Prices"), ("Prices", "ราคา", "Prices"), ("TokenRates", "อัตรา Token", "Tokens"), ("TokenPolicies", "นโยบาย Token", "Tokens"), ("Ledger", "บัญชี Token", "Tokens"), ("Orders", "คำสั่งซื้อ", "Orders"), ("Payments", "ชำระเงิน", "Payments"), ("POS", "จุดขาย POS", "Settings"), ("Imports", "นำเข้า Marketplace", "Payments"), ("Inventory", "สต็อก / ล็อต", "Inventory"), ("StockCard", "Stock card", "Inventory"), ("Warehouses", "คลังสินค้า", "Inventory"), ("Returns", "คืนสินค้า", "Refunds"), ("Promotions", "โปรโมชัน", "Prices"), ("Reports", "รายงาน", "Reports"), ("AuditLogs", "Audit logs", "Settings"), ("Notifications", "แจ้งเตือนคลัง", "Settings"), ("Settings", "ตั้งค่า", "Settings") })
{ if ((await Authorization.AuthorizeAsync(User, item.Item3)).Succeeded) { <a class="@(Model.Section == item.Item1 ? "active" : "")" href="/Admin?section=@item.Item1">@item.Item2</a> } }
<a href="/Stock">ภาพรวมสต๊อกทุกคลัง ↗</a></nav></aside><div class="col-lg-10"><div class="page-heading"><button class="btn btn-outline-success no-print" data-print>พิมพ์รายงานหน้านี้</button><div><p class="eyebrow">AM HERB OPERATIONS</p><h1 class="h2">@Model.Title</h1></div>@if ((await Authorization.AuthorizeAsync(User, "Reports")).Succeeded) { <a class="btn btn-outline-success" asp-action="Export" asp-route-section="@Model.Section" asp-route-q="@Model.Search" asp-route-from="@Context.Request.Query["from"]" asp-route-to="@Context.Request.Query["to"]">ส่งออก CSV</a> }</div>
@if (Model.Metrics.Count > 0) { <div class="row g-3 mb-4">@foreach (var metric in Model.Metrics) { <div class="col-sm-6 col-xl-3"><div class="metric-card compact"><span>@metric.Key</span><strong class="fs-4">@metric.Value</strong></div></div> }</div> }
<form method="get" class="search-bar mb-3"><input type="hidden" name="section" value="@Model.Section" /><input name="q" value="@Model.Search" placeholder="ค้นหา" class="form-control" aria-label="ค้นหารายการ" />@if (Model.Section is "Reports" or "Dashboard") { <input type="date" name="from" class="form-control" aria-label="เริ่มวันที่" /><input type="date" name="to" class="form-control" aria-label="ถึงวันที่" /> }<button class="btn btn-success">แสดง</button></form>
@if (Model.Section == "Products") { <a class="btn btn-success mb-3" href="/Admin/Product">+ เพิ่มสินค้า / SKU</a> }
@if (Model.Section is "Reports" or "Dashboard") { <div class="d-flex flex-wrap gap-2 mb-3">@foreach (var dimension in new[] { "Channel", "SKU", "Campaign", "Seller", "Upline" }) { <a class="btn btn-sm btn-outline-success" href="/Admin?section=Reports&q=@dimension">@dimension</a> }</div> }
@if (Model.Tree.Count > 0) { <div class="card p-4 mb-4">@foreach (var root in Model.Tree.Where(x => x.ParentId == null)) { <partial name="_TreeNode" model="(root, Model.Tree)" /> }</div> }
@if (Model.Headers.Length > 0) { <div class="card table-responsive mb-3"><table class="table mb-0"><thead><tr>@foreach (var h in Model.Headers) { <th>@h</th> }@if (Model.Section == "Products") { <th></th> }</tr></thead><tbody>@foreach (var row in Model.Rows) { <tr>@for (var i = 0; i < row.Cells.Length; i++) { <td>@if(Model.Section=="Products" && i==0){<img class="circle-thumb me-2" src="/Media/Thumb/@row.Cells[0]" alt="ภาพสินค้า" loading="lazy"/>}@if (i == 0 && row.Link != null) { <a href="@row.Link">@row.Cells[i]</a> } else { @row.Cells[i] }</td> }@if (Model.Section == "Products") { <td><a href="/Admin/Product/@row.Cells[0]">แก้ไข</a></td> }</tr> }@if (Model.Rows.Count == 0) { <tr><td colspan="@Model.Headers.Length" class="text-center text-muted py-4">ยังไม่มีรายการ</td></tr> }</tbody></table></div><div class="d-flex gap-3 mb-4"><a href="/Admin?section=@Model.Section&page=@Math.Max(1, Model.Page - 1)&q=@Model.Search">← ก่อนหน้า</a><span>หน้า @Model.Page</span><a href="/Admin?section=@Model.Section&page=@(Model.Page + 1)&q=@Model.Search">ถัดไป →</a></div> }
@if (Model.Section == "Imports") { <div class="card p-4"><h2 class="h4">นำเข้าคำสั่งซื้อจาก CSV</h2><p>จับคู่สินค้าด้วย SKU และป้องกันรายการซ้ำด้วยช่องทาง + ExternalOrderId</p><a href="/samples/marketplace-orders.csv" class="mb-3">ดาวน์โหลดแม่แบบ CSV</a><form method="post" asp-action="Import" enctype="multipart/form-data"><input type="file" name="file" accept=".csv" class="form-control mb-3" required /><button class="btn btn-success">นำเข้ารายการ</button></form>@if (TempData["ImportResult"] is string result) { <pre class="mt-3">@result</pre> }</div> }
@foreach (var form in AdminForms.For(Model))
{ <details class="card p-4 mb-3"><summary class="fw-bold">@form.Title</summary><form method="post" asp-action="@form.Action" class="row g-3 mt-1">@if (form.Warning != null) { <div class="col-12"><div class="alert alert-warning mb-0">@form.Warning</div></div> }
@foreach (var f in form.Fields) { <div class="@(f.Name == "reason" ? "col-12" : "col-md-6 col-xl-4")"><label class="form-label" for="@(form.Action + f.Name)">@f.Label</label>@if (f.Type == "select") { <select id="@(form.Action + f.Name)" name="@f.Name" class="form-select" required="@f.Required">@foreach (var option in f.Options!) { <option value="@option.Key">@option.Value</option> }</select> } else if (f.Type == "checkbox") { <div><input id="@(form.Action + f.Name)" type="checkbox" name="@f.Name" value="true" class="form-check-input" /></div> } else { <input id="@(form.Action + f.Name)" type="@f.Type" name="@f.Name" value="@f.Value" class="form-control" required="@f.Required" step="@(f.Type == "number" ? "any" : null)" /> }</div> }
<div class="col-12"><button class="btn btn-success">บันทึก</button></div></form></details> }
</div></div>




