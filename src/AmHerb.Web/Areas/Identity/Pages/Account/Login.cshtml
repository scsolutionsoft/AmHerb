@page
@model AmHerb.Web.Areas.Identity.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{Layout="/Views/Shared/_Layout.cshtml";ViewData["Title"]="เข้าสู่ระบบ";}
<section class="login-shell"><div class="login-story"><img src="/Media/Brand/4" alt="AM HERB Balance & Restore"/><div class="login-story-copy"><p class="eyebrow">BALANCE & RESTORE</p><h1>ดูแลตัวเอง<br/>เชื่อมต่อสิ่งดี ๆ</h1><p>สินค้า สมาชิก และสิทธิพิเศษ<br/>ในพื้นที่เดียวสำหรับคุณ</p></div></div><div class="login-form-panel"><img class="login-icon" src="/images/product-placeholder.svg" alt="AM HERB"/><p class="eyebrow mt-4">WELCOME TO AM HERB</p><h2>ยินดีต้อนรับกลับ</h2><p class="text-muted mb-4">เข้าสู่บัญชีเพื่อจัดการคำสั่งซื้อและสิทธิสมาชิก</p><form id="account" method="post"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><label asp-for="Input.Email">อีเมล</label><div class="input-icon-wrap"><span aria-hidden="true">＠</span><input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" required/></div><span asp-validation-for="Input.Email" class="text-danger"></span><label asp-for="Input.Password" class="mt-3">รหัสผ่าน</label><div class="input-group"><input asp-for="Input.Password" class="form-control" autocomplete="current-password" required/><button class="btn btn-outline-success" type="button" data-password-toggle="Input_Password" aria-label="แสดงรหัสผ่าน">แสดง</button></div><span asp-validation-for="Input.Password" class="text-danger"></span><div class="d-flex flex-wrap justify-content-between gap-2 my-4"><label><input asp-for="Input.RememberMe" class="form-check-input me-2"/>จดจำการเข้าสู่ระบบ</label><a asp-page="./ForgotPassword">ลืมรหัสผ่าน?</a></div><button id="login-submit" class="btn btn-success btn-lg w-100" type="submit">เข้าสู่ระบบ →</button></form>@if(Model.ExternalLogins.Count>0){<form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mt-3">@foreach(var provider in Model.ExternalLogins){<button class="btn btn-outline-success w-100" name="provider" value="@provider.Name">เข้าสู่ระบบด้วย @provider.DisplayName</button>}</form>}<p class="text-center mt-4 mb-0">ยังไม่มีบัญชี? <a href="/Account/Register" class="fw-bold">สมัครสมาชิก</a></p><a class="small d-block text-center mt-3" asp-page="./ResendEmailConfirmation">ส่งอีเมลยืนยันอีกครั้ง</a></div></section>
