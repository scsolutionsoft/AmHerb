@model AmHerb.Web.Controllers.NetworkTokensPage
@{ ViewData["Title"] = "Token และรางวัลเครือข่าย"; }
<h1>Token และรางวัลเครือข่าย</h1><partial name="_StoreNav"/>
<p>แสดงรางวัลที่คุณได้รับจากยอดขายของตนเองและดาวน์ไลน์ ไม่มีการโอน Token ระหว่างสมาชิก ยอดกระเป๋าของผู้อื่นไม่แสดงในหน้านี้</p>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card p-3">รอปลดล็อก<strong class="h2">@Model.Wallet.Pending.ToString("N2")</strong></div></div><div class="col-md-4"><div class="card p-3">พร้อมใช้<strong class="h2">@Model.Wallet.Available.ToString("N2")</strong></div></div><div class="col-md-4"><div class="card p-3">จองสำหรับคำสั่งซื้อ<strong class="h2">@Model.Wallet.Reserved.ToString("N2")</strong></div></div></div>
<div class="alert alert-info">ใช้ Token ของคุณผ่านตะกร้าเมื่อเข้าสู่ระบบ หรือสร้างรหัสอนุมัติแลกที่ POS จาก <a href="/Member">หน้าสมาชิก</a> ตามวงเงินและสินค้าที่ร่วมรายการ</div>
<h2 class="h4">ที่มารางวัลสะสม</h2><div class="table-responsive"><table class="table"><thead><tr><th>ประเภท</th><th>ได้รับเดิม</th><th>ปรับคืนสินค้า</th><th>หมดอายุ</th></tr></thead><tbody>@for(var i=0;i<=3;i++) { var r=Model.Summary.FirstOrDefault(x=>x.Level==i); <tr><td>@(i==0?"ขายเอง / Loyalty":"รางวัลอัพไลน์ L"+i+" จากดาวน์ไลน์")</td><td>@((r?.Original??0).ToString("N2"))</td><td>@((r?.Reversed??0).ToString("N2"))</td><td>@((r?.Expired??0).ToString("N2"))</td></tr> }</tbody></table></div>
<p class="small text-muted">ยอดรางวัลสะสมไม่ใช่ยอดพร้อมใช้ เพราะอาจมีการแลก จอง หรือปรับยอดแล้ว ระดับรางวัลอ้างอิงเครือข่าย ณ วันที่ให้รางวัล ส่วนรายชื่อเครือข่ายด้านล่างเป็นโครงสร้างปัจจุบัน</p>
<form method="get" class="d-flex gap-2 mb-3"><select name="level" class="form-select" aria-label="ระดับรางวัล"><option value="">ทุกระดับ</option>@for(var i=0;i<=3;i++) { <option value="@i" selected="@(Model.Level==i)">@(i==0?"ขายเอง":"อัพไลน์ L"+i)</option> }</select><button class="btn btn-success">กรอง</button><a class="btn btn-outline-success" asp-action="Export" asp-route-level="@Model.Level">CSV</a></form>
<div class="table-responsive"><table class="table"><thead><tr><th>คำสั่งซื้อ / ผู้ขาย</th><th>ระดับ</th><th>รางวัล</th><th>ปรับคืน / หมดอายุ</th><th>สถานะล็อต</th><th>ปลดล็อก / หมดอายุ</th></tr></thead><tbody>@foreach(var r in Model.Rewards) { <tr><td>@r.Order <small class="d-block">@r.SellerCode</small></td><td>@r.Level</td><td>@r.Amount.ToString("N2")</td><td>@r.Reversed.ToString("N2") / @r.Expired.ToString("N2")</td><td>@r.Status</td><td>@Bangkok.Format(r.ReleaseAt)<br/>@Bangkok.Format(r.ExpireAt)</td></tr> }</tbody></table></div>
@if(Model.Rewards.Count==0) { <p>ยังไม่มีรางวัลในระดับที่เลือก รางวัลเกิดหลังฝ่ายการเงินยืนยันยอดขายปลีกที่ส่งมอบแล้ว</p> }
<div class="d-flex gap-3 mb-4">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-level="@Model.Level">ก่อนหน้า</a>}@if(Model.HasNext){<a asp-route-page="@(Model.Page+1)" asp-route-level="@Model.Level">ถัดไป</a>}</div>
<h2 class="h4">ประวัติ Token ล่าสุด 50 รายการ</h2><div class="table-responsive"><table class="table"><thead><tr><th>วันที่</th><th>รายการ</th><th>รอปลดล็อก ±</th><th>พร้อมใช้ ±</th><th>จอง ±</th></tr></thead><tbody>@foreach(var l in Model.Ledger){<tr><td>@Bangkok.Format(l.PostedAt)</td><td>@l.Kind</td><td>@l.PendingDelta.ToString("N2")</td><td>@l.AvailableDelta.ToString("N2")</td><td>@l.ReservedDelta.ToString("N2")</td></tr>}</tbody></table></div>
<h2 class="h4">อัพไลน์–ดาวน์ไลน์ปัจจุบัน (สูงสุด 100 รายชื่อ)</h2><div class="table-responsive"><table class="table"><thead><tr><th>ความสัมพันธ์</th><th>ชั้น</th><th>รหัสสมาชิก</th><th>ชื่อ</th></tr></thead><tbody>@foreach(var r in Model.Relations){<tr><td>@r.Direction</td><td>@r.Depth</td><td>@r.Code</td><td>@r.Name</td></tr>}</tbody></table></div>
