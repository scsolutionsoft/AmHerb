@inject Microsoft.AspNetCore.Authorization.IAuthorizationService NavAuthorization
<!DOCTYPE html>
<html lang="th"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · AM HERB</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/comfort.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/experience.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/health.css" asp-append-version="true"/></head>
<body><a class="skip-link" href="#main-content">ข้ามไปเนื้อหาหลัก</a><header class="site-header no-print"><div class="topbar">AM HERB · BALANCE & RESTORE · ใส่ใจสุขภาพในทุกวัน</div><nav class="navbar navbar-expand-xl bg-white"><div class="container-fluid site-width"><a class="navbar-brand brand" href="/">AM <span>HERB</span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav" aria-controls="main-nav" aria-expanded="false" aria-label="เปิดเมนู"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="main-nav"><ul class="navbar-nav me-auto"><li><a class="nav-link" href="/Catalog">ผลิตภัณฑ์</a></li><li><a class="nav-link" href="/News">ข่าว / โปรโมชั่น</a></li><li><a class="nav-link" href="/Cart">ตะกร้า</a></li><li><a class="nav-link" href="/Orders/Track">ติดตามสินค้า</a></li>@if(User.Identity?.IsAuthenticated==true){<li><a class="nav-link" href="/Messages">ข้อความ <span class="badge" id="message-badge" hidden aria-live="polite"></span></a></li><li class="nav-item dropdown"><button class="nav-link dropdown-toggle border-0 bg-transparent" data-bs-toggle="dropdown" aria-expanded="false">พื้นที่สมาชิก</button><ul class="dropdown-menu"><li><a class="dropdown-item" href="/Member">สมาชิก / Token</a></li><li><a class="dropdown-item" href="/Credit">เครดิต / ชำระหนี้</a></li><li><a class="dropdown-item" href="/Pos">POS ของฉัน</a></li><li><a class="dropdown-item" href="/Stock">รายงานสต๊อก</a></li><li><a class="dropdown-item" href="/Transfers">เบิกสินค้า</a></li></ul></li>}
@if(AmHerb.Web.Data.SeedData.Roles.Where(x=>x!="Member").Any(User.IsInRole)){<li class="nav-item dropdown"><button class="nav-link dropdown-toggle border-0 bg-transparent" data-bs-toggle="dropdown" aria-expanded="false">หลังบ้าน</button><ul class="dropdown-menu"><li><a class="dropdown-item" href="/Admin">ศูนย์จัดการ</a></li>@if((await NavAuthorization.AuthorizeAsync(User,"Prices")).Succeeded){<li><a class="dropdown-item" href="/News/Manage">ข่าวและโฆษณา</a></li>}@if((await NavAuthorization.AuthorizeAsync(User,"Payments")).Succeeded){<li><a class="dropdown-item" href="/Accounting">บัญชีเดบิต–เครดิต</a></li><li><a class="dropdown-item" href="/Credit">วงเงินเครดิต / ลูกหนี้</a></li>}</ul></li>}</ul><partial name="_LoginPartial"/></div></div></nav></header>
<main class="site-width container-fluid py-4 py-lg-5" id="main-content">@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-warning" role="alert">@error</div>}@RenderBody()</main>
<footer class="site-footer no-print"><div class="site-width container-fluid d-flex flex-wrap justify-content-between gap-3"><div><span class="brand">AM HERB</span><p class="small mt-2 mb-0">BALANCE & RESTORE</p></div><div class="small text-muted">AM Token ใช้แลกสินค้าภายในระบบเท่านั้น<br/><a href="/Messages">ติดต่อทีมดูแลสมาชิก</a> · <a href="/Home/Privacy">ความเป็นส่วนตัวและข้อกำหนด</a> · © @DateTime.UtcNow.Year AM HERB</div></div></footer>
<partial name="_Popups"/><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/experience.js" asp-append-version="true"></script><script src="~/js/product-editor.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)
</body></html>



