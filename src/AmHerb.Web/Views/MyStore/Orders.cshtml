@model List<Order>
@{ ViewData["Title"] = "คำสั่งซื้อร้าน"; }
<h1>คำสั่งซื้อร้าน</h1><partial name="_StoreNav"/>
<form method="get" class="d-flex gap-2 mb-3"><select name="status" class="form-select" aria-label="สถานะ"><option value="">ทุกสถานะ</option>@foreach(var s in Enum.GetValues<OrderStatus>()) { <option value="@s" selected="@(ViewBag.Status != null && (OrderStatus)ViewBag.Status == s)">@s</option> }</select><button class="btn btn-success">กรอง</button></form>
@if(Model.Count == 0) { <p class="alert alert-info">ยังไม่มีคำสั่งซื้อในช่วงที่เลือก</p> }
@foreach(var o in Model) {
<section class="card p-3 mb-3"><div class="d-flex flex-wrap justify-content-between"><a href="/Orders/Detail/@o.PublicId"><strong>@o.Number</strong></a><span>@o.Status · @Bangkok.Format(o.CreatedAt)</span></div><p>@o.CustomerName · @(o.StoreId == null ? "POS" : "ออนไลน์ร้าน") · ยอดชำระ @o.CashPayable.ToString("N2") บาท</p>
@if(o.StoreId != null && o.Status is OrderStatus.Paid or OrderStatus.Processing) { <form asp-action="Ship" method="post" class="row g-2"><input type="hidden" name="id" value="@o.Id"/><div class="col-sm-4"><input name="carrier" class="form-control" maxlength="120" placeholder="ผู้ขนส่ง" aria-label="ผู้ขนส่ง" required/></div><div class="col-sm-5"><input name="tracking" class="form-control" maxlength="120" placeholder="เลขพัสดุ" aria-label="เลขพัสดุ" required/></div><div class="col-sm-3"><button class="btn btn-success">บันทึกจัดส่ง</button></div></form> }
@if(o.StoreId != null && o.Status == OrderStatus.Shipped) { <form asp-action="Ship" method="post"><input type="hidden" name="id" value="@o.Id"/><input type="hidden" name="delivered" value="true"/><button class="btn btn-outline-success">ยืนยันส่งมอบแล้ว</button></form> }
</section>
}
<div class="d-flex gap-2">@if(ViewBag.Page > 1) { <a asp-action="Orders" asp-route-page="@(ViewBag.Page - 1)" asp-route-status="@ViewBag.Status">ก่อนหน้า</a> } @if(ViewBag.HasNext) { <a asp-action="Orders" asp-route-page="@(ViewBag.Page + 1)" asp-route-status="@ViewBag.Status">ถัดไป</a> }</div>
