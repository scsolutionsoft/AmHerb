@model Conversation
@using AmHerb.Web.Controllers
@using System.Security.Claims
@{ViewData["Title"]=Model.Subject;var staff=ConversationService.Staff(User);var uid=User.FindFirstValue(ClaimTypes.NameIdentifier);string Sender(ConversationMessage m)=>m.FromStaff?"AM HERB Member Care":m.SenderUserId==Model.Member.UserId?Model.Member.Name:Model.OtherMember?.Name??"สมาชิก";}
<div class="page-heading"><div><p class="eyebrow">MEMBER MESSAGING · #@Model.Id</p><h1 class="h2">@Model.Subject</h1><p>@MessagesController.Label(Model.Status) · @(Model.OtherMember==null?"สนทนากับทีมดูแล":$"ระหว่าง {Model.Member.Name} และ {Model.OtherMember.Name}")</p></div><a href="/Messages" class="btn btn-outline-success">กลับศูนย์ข้อความ</a></div>
<section class="card p-3 p-lg-4 chat-thread">@foreach(var message in Model.Messages.OrderBy(x=>x.Id)){<article class="chat-bubble @(message.SenderUserId==uid?"mine":"")"><strong>@Sender(message)</strong>@if(!string.IsNullOrWhiteSpace(message.Body)){<p>@message.Body</p>}@if(message.AttachmentData!=null){<div class="border rounded p-2 my-2 bg-white"><div class="small fw-bold">📎 @message.AttachmentName</div><div class="d-flex gap-2 mt-2"><button type="button" class="btn btn-sm btn-outline-success" data-attachment-preview data-url="@Url.Action("Attachment",new{id=message.Id})" data-name="@message.AttachmentName" data-type="@message.AttachmentContentType">พรีวิว</button><a class="btn btn-sm btn-outline-secondary" asp-action="Attachment" asp-route-id="@message.Id" asp-route-download="true">ดาวน์โหลด</a></div></div>}<small>@Bangkok.Format(message.SentAt) · @(message.ReadAt==null?"ส่งแล้ว":"อ่านแล้ว")</small></article>}</section>
<form asp-action="Read" method="post" data-mark-read><input type="hidden" name="id" value="@Model.Id"/></form>
@if(Model.Status!=ConversationStatus.Closed){<form asp-action="Send" method="post" enctype="multipart/form-data" class="card p-4 mt-3"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="key" value="@Guid.NewGuid()"/><label for="reply-body">ตอบกลับ</label><textarea class="form-control mb-3" id="reply-body" name="body" rows="4" maxlength="4000" placeholder="พิมพ์ข้อความ หรือแนบไฟล์อย่างน้อยหนึ่งอย่าง"></textarea><label for="reply-file">แนบรูปหรือเอกสาร</label><input class="form-control mb-2" id="reply-file" type="file" name="attachment" accept="image/jpeg,image/png,image/webp,application/pdf,text/plain,.docx,.xlsx"/><span class="small text-muted mb-3">สูงสุด 8 MB · JPEG, PNG, WebP, PDF, TXT, DOCX, XLSX</span><button class="btn btn-success align-self-end">ส่งคำตอบ</button></form><details class="mt-3"><summary>ปิดเรื่องนี้</summary><form asp-action="Close" method="post" class="d-flex gap-2 mt-3"><input type="hidden" name="id" value="@Model.Id"/><input class="form-control" name="reason" maxlength="500" placeholder="เหตุผลปิดเรื่อง" aria-label="เหตุผลปิดเรื่อง" required/><button class="btn btn-outline-success text-nowrap">ปิดเรื่อง</button></form></details>}
<div class="modal fade" id="attachment-preview-modal" tabindex="-1" aria-labelledby="attachment-preview-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="attachment-preview-title">พรีวิวไฟล์</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button></div><div class="modal-body text-center" style="min-height:60vh"><img id="attachment-preview-image" class="img-fluid" alt="" hidden/><iframe id="attachment-preview-frame" title="พรีวิวเอกสาร" style="width:100%;height:65vh;border:0" hidden></iframe><div id="attachment-preview-office" class="py-5" hidden><div class="display-4">📄</div><p class="mt-3 mb-1 fw-bold">เอกสาร Office พร้อมดาวน์โหลด</p><p class="text-muted">เบราว์เซอร์ไม่สามารถแสดงเนื้อหา DOCX/XLSX โดยตรง กรุณาดาวน์โหลดเพื่อเปิดในโปรแกรมเอกสาร</p></div></div><div class="modal-footer"><a id="attachment-preview-download" class="btn btn-outline-success" download>ดาวน์โหลดไฟล์</a><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button></div></div></div></div>
@section Scripts {<script src="~/js/message-attachments.js" asp-append-version="true"></script>}
