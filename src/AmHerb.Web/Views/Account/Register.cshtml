@model RegisterInput
@{ ViewData["Title"] = "สมัครสมาชิก"; }
<div class="auth-card card mx-auto"><div class="card-body p-4 p-lg-5">
<p class="eyebrow">AM HERB COMMUNITY</p><h1 class="h3">สมัครสมาชิก</h1><p class="text-muted">ดูแลสุขภาพ เชื่อมต่อสิทธิประโยชน์จากการซื้อสินค้า</p>
<form method="post" asp-action="Register"><div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="Name" class="form-label">ชื่อ-นามสกุล</label><input asp-for="Name" class="form-control mb-3" autocomplete="name" />
<label asp-for="Email" class="form-label">อีเมล</label><input asp-for="Email" class="form-control mb-3" autocomplete="email" />
<label asp-for="Password" class="form-label">รหัสผ่าน (12 ตัวขึ้นไป มีตัวใหญ่ ตัวเล็ก ตัวเลข และสัญลักษณ์)</label><input asp-for="Password" class="form-control mb-3" autocomplete="new-password" />
<label asp-for="ConfirmPassword" class="form-label">ยืนยันรหัสผ่าน</label><input asp-for="ConfirmPassword" class="form-control mb-3" autocomplete="new-password" />
<label asp-for="SponsorCode" class="form-label">รหัสแนะนำ (ถ้ามี)</label><input asp-for="SponsorCode" class="form-control mb-3" />
<p class="small text-muted">ไม่มีรางวัลจากการสมัครหรือแนะนำสมาชิก Token เกิดจากการขายปลีกที่ตรวจสอบแล้วเท่านั้น</p>
<button class="btn btn-success w-100">สร้างบัญชี</button></form></div></div>
