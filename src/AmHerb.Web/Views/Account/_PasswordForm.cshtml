@model AmHerb.Web.Areas.Identity.Pages.Account.PasswordPage
<div class="card p-4 mx-auto" style="max-width:560px"><p class="eyebrow">AM HERB ACCOUNT</p><h1 class="h3">@Model.Heading</h1><p class="text-muted">รหัสผ่าน 5–10 ตัวอักษร ไม่บังคับตัวใหญ่ ตัวเลข หรือสัญลักษณ์</p><form method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if(Model.IsReset) { <input asp-for="Input.Code" type="hidden" /><label asp-for="Input.Email" class="form-label">อีเมลของบัญชี</label><input asp-for="Input.Email" class="form-control mb-3" type="email" autocomplete="email" required /> }
@if(!Model.IsReset && !Model.IsSet) { <label asp-for="Input.OldPassword" class="form-label">รหัสผ่านปัจจุบัน</label><input asp-for="Input.OldPassword" class="form-control mb-3" autocomplete="current-password" required /> }
<label asp-for="Input.Password" class="form-label">รหัสผ่านใหม่</label><input asp-for="Input.Password" class="form-control mb-3" autocomplete="new-password" minlength="5" maxlength="10" required /><label asp-for="Input.ConfirmPassword" class="form-label">พิมพ์รหัสผ่านใหม่อีกครั้ง</label><input asp-for="Input.ConfirmPassword" class="form-control mb-3" autocomplete="new-password" minlength="5" maxlength="10" required /><button class="btn btn-success w-100">บันทึกรหัสผ่าน</button></form><a class="mt-3" href="@(Model.IsReset ? "/Identity/Account/Login" : "/Member#profile")">กลับ</a></div>
