@model DownlineDetail
@{ ViewData["Title"] = "รายละเอียดดาวน์ไลน์"; }
<div class="page-heading"><h1 class="h3">รายละเอียดดาวน์ไลน์</h1><a class="btn btn-outline-success" href="/Member#network">กลับเครือข่าย</a></div>
<partial name="_LiveStatus" />
<section class="card p-4" data-live-region="downline">
<h2 class="h4">@Model.Member.Name</h2><p>@Model.Member.Code · ชั้นที่ @Model.Member.Depth · @MemberLabels.Member(Model.Member.Status)</p>
<h3 class="h5 mt-3">สมาชิกที่แนะนำโดยตรง (@Model.Children.Count คน)</h3>
<div class="list-group">
@foreach (var child in Model.Children) { <a class="list-group-item list-group-item-action" href="/Member/Downline/@child.Id">@child.Name · @child.Code <span class="float-end">@MemberLabels.Member(child.Status) →</span></a> }
@if (Model.Children.Count == 0) { <p class="text-muted">ยังไม่มีสมาชิกที่แนะนำโดยตรง</p> }
</div></section>
@section Scripts { <script src="~/js/member-live.js" asp-append-version="true"></script> }
