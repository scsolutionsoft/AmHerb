@model AmHerb.Web.Controllers.StockPage
@using AmHerb.Web.Controllers
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{ ViewData["Title"] = "รายงานสต๊อกสินค้า"; var manage = (await Authorization.AuthorizeAsync(User, "Inventory")).Succeeded; }
<section class="stock-heading page-heading">
 <div><p class="eyebrow">INVENTORY OVERVIEW</p><h1>สต๊อกสินค้า<span class="heading-dot">.</span></h1><p class="text-muted">@(Model.Staff ? "ภาพรวมบริษัทกลาง ดีลเลอร์ และสมาชิก" : "ติดตามสินค้าในคลังของคุณ") · @Bangkok.Format(DateTime.UtcNow)</p></div>
 <div class="d-flex gap-2 flex-wrap no-print"><a class="btn btn-outline-success" asp-action="Export" asp-route-kind="@Model.Kind" asp-route-warehouseId="@Model.WarehouseId" asp-route-q="@Model.Q" asp-route-alert="@Model.Alert">ดาวน์โหลด CSV</a><button class="btn btn-outline-success" data-print>พิมพ์รายงาน</button>@if(manage){<a class="btn btn-success" href="/Admin?section=Inventory">+ รับสินค้า / ปรับยอด</a>}</div>
</section>
<div class="card p-3 mb-4 d-flex flex-row flex-wrap justify-content-between align-items-center gap-3"><div><strong>ระหว่างขนส่ง @Model.InTransit.ToString("N0") ชิ้น</strong><div class="small text-muted">แยกจากยอดคงคลัง · ตามคลังและคำค้นที่เลือก ไม่ใช้ตัวกรองสถานะสินค้า</div></div><a class="btn btn-outline-success no-print" href="/Transfers">เบิกสินค้า / ติดตามการรับเข้า →</a></div>
<nav class="stock-tabs no-print" aria-label="ประเภทคลัง">
 <a class="@(Model.Kind == null ? "selected" : "")" href="/Stock" aria-current="@(Model.Kind == null ? "page" : null)">ทั้งหมด</a>
 @foreach(var kind in Enum.GetValues<WarehouseKind>()){<a class="@(Model.Kind == kind ? "selected" : "")" asp-action="Index" asp-route-kind="@kind" aria-current="@(Model.Kind == kind ? "page" : null)">@StockPage.Label(kind)<span>@Model.Warehouses.Count(x=>x.Kind==kind)</span></a>}
</nav>
<div class="stock-metrics">
 <div class="metric-card stock-primary"><span>คงคลังทั้งหมด</span><strong>@Model.Rows.Sum(x=>x.OnHand).ToString("N0") <small>ชิ้น</small></strong><p>รวมพร้อมขาย จอง และสินค้าขายไม่ได้</p></div>
 <div class="metric-card"><span>พร้อมขาย</span><strong>@Model.Rows.Sum(x=>x.Available).ToString("N0")</strong><p>คลังเปิดใช้และยังไม่หมดอายุ</p></div>
 <div class="metric-card"><span>จองในคำสั่งซื้อ</span><strong>@Model.Rows.Sum(x=>x.Reserved).ToString("N0")</strong><p>แยกออกจากจำนวนพร้อมขาย</p></div>
 <div class="metric-card"><span>ต้องติดตาม</span><strong>@Model.Rows.Count(x=>x.Available<=x.Threshold || x.Expiring>0 || x.Expired>0) <small>รายการ</small></strong><p>ใกล้หมด / ใกล้หมดอายุ / หมดอายุ</p></div>
</div>
<form method="get" class="card stock-filters no-print">
 <input type="hidden" name="kind" value="@Model.Kind" />
 <div><label for="stock-search">ค้นหาสินค้า</label><input class="form-control" id="stock-search" name="q" value="@Model.Q" placeholder="ชื่อสินค้า, SKU หรือเลขล็อต" maxlength="150" /></div>
 <div><label for="stock-warehouse">คลังสินค้า</label><select class="form-select" id="stock-warehouse" name="warehouseId"><option value="">ทุกคลังที่มีสิทธิ์ดู</option>@foreach(var w in Model.Warehouses.Where(x=>Model.Kind==null||x.Kind==Model.Kind)){<option value="@w.Id" selected="@(Model.WarehouseId==w.Id)">@w.Name @(w.Active ? "" : "(ปิดใช้)")</option>}</select></div>
 <div><label for="stock-alert">สถานะสินค้า</label><select class="form-select" id="stock-alert" name="alert"><option value="">ทั้งหมด</option><option value="low" selected="@(Model.Alert=="low")">ถึงจุดเติมสินค้า</option><option value="expiry" selected="@(Model.Alert=="expiry")">หมดอายุภายใน 90 วัน</option><option value="expired" selected="@(Model.Alert=="expired")">หมดอายุแล้ว</option></select></div>
 <button class="btn btn-success">แสดงรายงาน</button><a class="btn btn-light" href="/Stock">ล้าง</a>
</form>
<section class="card mt-4 overflow-hidden">
 <div class="stock-section-title"><div><h2>ยอดสินค้าคงคลัง</h2><p>@Model.Rows.Count รายการ · ยอดตามตัวกรองที่เลือก</p></div>@if(Model.Staff){<div class="text-end"><span class="text-muted">มูลค่าทุนคงคลัง</span><div class="fw-bold fs-4">฿@Model.Rows.Sum(x=>x.Value).ToString("N2")</div></div>}</div>
 <div class="table-responsive"><table class="table stock-table mb-0"><thead><tr><th>สินค้า / SKU</th><th>คลัง / เจ้าของ</th><th class="text-end">คงคลัง</th><th class="text-end">พร้อมขาย</th><th class="text-end">จอง</th><th>สถานะ</th></tr></thead><tbody>
 @foreach(var r in Model.Rows){<tr><td><img class="circle-thumb me-2" src="/Media/Thumb/@r.SkuId" alt="@r.Product" loading="lazy"/><strong>@r.Product</strong><small>@r.Sku</small>@if(manage){<button type="button" class="btn btn-sm btn-outline-success mt-2 no-print" data-bs-toggle="modal" data-bs-target="#stock-adjust-modal" data-sku="@r.SkuId" data-warehouse="@r.WarehouseId">ปรับสต๊อก</button>}</td><td>@r.Warehouse<small>@StockPage.Label(r.Kind) · @r.Owner</small></td><td data-label="คงคลัง" class="text-end">@r.OnHand.ToString("N0")</td><td data-label="พร้อมขาย" class="text-end fw-bold">@r.Available.ToString("N0")</td><td data-label="จอง" class="text-end">@r.Reserved.ToString("N0")</td><td><div class="d-flex flex-column align-items-start gap-1">@if(r.Available<=r.Threshold){<span class="badge stock-warning">เติมสินค้า · ขั้นต่ำ @r.Threshold</span>}@if(r.Expiring>0){<span class="badge stock-warning">ใกล้หมดอายุ @r.Expiring ชิ้น</span>}@if(r.Expired>0){<span class="badge stock-danger">หมดอายุ @r.Expired ชิ้น</span>}@if(r.Available>r.Threshold&&r.Expiring==0&&r.Expired==0){<span class="badge stock-good">ปกติ</span>}</div></td></tr>}
 @if(Model.Rows.Count==0){<tr><td colspan="6" class="stock-empty"><span class="empty-symbol">□</span><h3>ยังไม่มีสินค้าตามเงื่อนไขนี้</h3><p>ลองเปลี่ยนตัวกรอง หรือให้ผู้ดูแลรับสินค้าเข้าคลังของคุณ</p><a href="/Stock">ดูคลังทั้งหมดที่มีสิทธิ์</a></td></tr>}
 </tbody></table></div>
</section>
<details class="card mt-4 p-4"><summary class="fw-bold">รายละเอียดล็อตและวันหมดอายุ (@Model.Lots.Count ล็อต)</summary><div class="table-responsive mt-3"><table class="table mb-0"><thead><tr><th>คลัง / SKU</th><th>ล็อต</th><th>วันหมดอายุ</th><th class="text-end">ยังไม่จอง</th><th class="text-end">จอง</th></tr></thead><tbody>@foreach(var lot in Model.Lots){<tr><td>@lot.Warehouse.Name<br />@lot.Sku.Code</td><td>@lot.LotNo @if(manage){<button type="button" class="btn btn-link btn-sm no-print" data-bs-toggle="modal" data-bs-target="#stock-adjust-modal" data-batch="@lot.Id">ปรับล็อตนี้</button>}</td><td>@lot.ExpDate.ToString("dd/MM/yyyy")</td><td class="text-end">@lot.QtyAvailable</td><td class="text-end">@lot.QtyReserved</td></tr>}</tbody></table></div><p class="small text-muted mb-0 mt-3">จำนวนยังไม่จองอาจรวมล็อตหมดอายุหรือคลังปิดใช้ ซึ่งไม่นับเป็นยอดพร้อมขาย</p></details>
@if(manage){<details class="card mt-4 p-4 no-print"><summary class="fw-bold">จัดการคลัง · เพิ่มคลังบริษัท / ดีลเลอร์ / สมาชิก</summary><form asp-action="CreateWarehouse" method="post" class="row g-3 mt-2"><div class="col-md-6"><label for="wh-name">ชื่อคลัง</label><input class="form-control" id="wh-name" name="name" maxlength="120" required /></div><div class="col-md-6"><label for="wh-kind">ประเภท</label><select class="form-select" id="wh-kind" name="kind">@foreach(var k in Enum.GetValues<WarehouseKind>()){<option value="@k">@StockPage.Label(k)</option>}</select></div><div class="col-md-6"><label for="wh-owner">เจ้าของคลัง (จำเป็นสำหรับดีลเลอร์และสมาชิก)</label><select class="form-select" id="wh-owner" name="ownerMemberId"><option value="">บริษัทกลาง</option>@foreach(var member in Model.Members){<option value="@member.Id">@member.Code · @member.Name</option>}</select></div><div class="col-md-6"><label for="wh-reason">เหตุผล / หมายเหตุ</label><input class="form-control" id="wh-reason" name="reason" maxlength="500" required /></div><div class="col-12"><button class="btn btn-success">สร้างคลัง</button><a class="btn btn-outline-success ms-2" href="/Admin?section=POS">กำหนดคลังให้ POS</a></div></form></details>}



@if(manage){<partial name="_StockAdjustment" />}
@section Scripts { <script src="~/js/stock-adjustment.js" asp-append-version="true"></script> }