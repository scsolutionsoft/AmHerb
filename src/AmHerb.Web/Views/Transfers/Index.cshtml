@model AmHerb.Web.Controllers.TransferPage
@using AmHerb.Web.Controllers
@{ ViewData["Title"] = "เบิกและโอนย้ายสินค้า"; }
<div class="page-heading"><div><p class="eyebrow">STOCK REPLENISHMENT</p><h1>เบิกและโอนย้ายสินค้า</h1><p class="text-muted">ออก PO → ชำระหรืออนุมัติเครดิต → จ่ายสินค้า → ยืนยันรับเข้าคลัง</p></div><a class="btn btn-outline-success" href="/Stock">ดูรายงานสต๊อก</a></div>
<div class="alert alert-info">ระบบแยกเอกสารการเงินออกจากการตัดสต๊อก สินค้าจะถูกตัดจากยอดพร้อมโอนเมื่อฝ่ายการเงินอนุมัติและคลังยืนยันจ่ายเท่านั้น รายการนี้ไม่สร้าง Token</div>
<nav class="stock-tabs" aria-label="สถานะใบเบิก"><a href="/Transfers" class="@(Model.Status == null ? "selected" : "")">ทั้งหมด</a>@foreach(var s in Enum.GetValues<TransferStatus>()){<a asp-action="Index" asp-route-status="@s" class="@(Model.Status == s ? "selected" : "")">@TransferPage.Label(s)</a>}</nav>
<details class="card p-4 mb-4" open><summary class="fw-bold">+ สร้างคำขอและออก PO</summary>
@if(Model.Destinations.Count == 0){<p class="mt-3 mb-0 text-muted">ยังไม่มีคลังปลายทางที่ใช้ได้ กรุณาให้ผู้ดูแลสร้างคลังและกำหนดคุณเป็นเจ้าของ</p>}
else {
<p class="small text-success mt-3" id="transfer-step-label" aria-live="polite">1 เลือกคลังและสินค้า → 2 ตรวจยอดและการชำระ → 3 ยืนยันออก PO</p>
<form id="transfer-request" data-transfer-form="request" method="post" asp-action="Create" class="row g-3 mt-2"><input name="key" type="hidden" value="@Guid.NewGuid()" />
<section data-transfer-step class="row g-3 m-0 p-0"><div class="col-md-6"><label for="transfer-source">คลังต้นทาง</label><select class="form-select" id="transfer-source" name="sourceId" required>@foreach(var w in Model.Sources){<option value="@w.Id">@w.Name</option>}</select></div><div class="col-md-6"><label for="transfer-destination">คลังปลายทาง</label><select class="form-select" id="transfer-destination" name="destinationId" required>@foreach(var w in Model.Destinations){<option value="@w.Id">@w.Name</option>}</select></div><div class="col-md-8"><label for="transfer-sku">สินค้า</label><select class="form-select" id="transfer-sku" name="skuId" required>@foreach(var sku in Model.Skus){<option value="@sku.Id">@sku.Code · @sku.Product.Name</option>}</select></div></section>
<section data-transfer-step class="row g-3 m-0 p-0"><partial name="_TransferBalances" /><div class="col-md-4"><label for="transfer-quantity">จำนวนชิ้น</label><input class="form-control" id="transfer-quantity" type="number" name="quantity" min="1" max="1000000" value="1" required /></div><div class="col-md-4"><label for="transfer-payment">วิธีชำระ</label><select class="form-select" id="transfer-payment" name="paymentMethod" required><option value="BankTransfer">โอนเงินและแนบสลิป</option><option value="Cash">เงินสด (ฝ่ายการเงินยืนยัน)</option><option value="MemberCredit">เครดิตสมาชิก</option>@if(Model.Manager){<option value="NoCharge">ไม่เรียกเก็บ</option>}</select></div><div class="col-md-4"><label for="transfer-price-tier">ประเภทราคา</label><select class="form-select" id="transfer-price-tier" name="priceTier" required><option value="Wholesale">ราคาส่ง</option><option value="Retail">ราคาปลีก</option><option value="Promo">ราคาโปรโมชัน</option><option value="Pack6">ราคาแพ็ก 6</option><option value="Pack12">ราคาแพ็ก 12</option></select></div><div class="col-12"><div class="alert alert-light border mb-0" id="transfer-financial-preview">เลือกสินค้าเพื่อดูยอด PO</div></div></section>
<section data-transfer-step class="row g-3 m-0 p-0"><div class="col-12"><h2 class="h5">ระบุเหตุผลและตรวจคำขอ</h2><p>เมื่อยืนยัน ระบบจะออกเลข PO และแจ้งขั้นตอนชำระเงินหรืออนุมัติเครดิตก่อนคลังจ่ายสินค้า</p><label for="transfer-reason">เหตุผลในการเบิก</label><input class="form-control" id="transfer-reason" name="reason" maxlength="900" required placeholder="เช่น เติมสินค้าเพื่อขายหน้าร้าน" /></div></section>
<div class="col-12 d-flex flex-wrap gap-2 align-items-center"><button class="btn btn-outline-success" type="button" id="transfer-back" hidden>ย้อนกลับ</button><button class="btn btn-success" type="button" id="transfer-next" hidden>ถัดไป</button><button class="btn btn-success" id="transfer-request-submit">ยืนยันและออก PO</button><span class="text-muted small ms-2">ยังไม่ตัดสต๊อกจนกว่าการเงินและคลังยืนยัน</span></div></form>}
</details>
<section class="card table-responsive"><table class="table mb-0"><thead><tr><th>PO / วันที่</th><th>ต้นทาง → ปลายทาง</th><th>สินค้า</th><th class="text-end">ยอดเรียกเก็บ</th><th>สถานะการเงิน / สินค้า</th></tr></thead><tbody>@foreach(var t in Model.Transfers){<tr><td><a asp-action="Detail" asp-route-id="@t.Id">@(string.IsNullOrWhiteSpace(t.PoNumber) ? $"TR-{t.Id:D8}" : t.PoNumber)</a><div class="small text-muted">@Bangkok.Format(t.CreatedAt)</div></td><td>@t.SourceWarehouse.Name → @t.DestinationWarehouse.Name</td><td>@t.Sku.Product.Name<div class="small text-muted">@t.Sku.Code · @t.Quantity.ToString("N0") ชิ้น</div></td><td class="text-end">@t.ChargeAmount.ToString("N2") บาท</td><td><span class="badge bg-light text-dark">@t.FinancialStatus</span> <span class="badge @(t.Status == TransferStatus.Dispatched ? "stock-warning" : t.Status == TransferStatus.Received ? "stock-good" : "")">@TransferPage.Label(t.Status)</span></td></tr>}@if(Model.Transfers.Count==0){<tr><td colspan="5" class="text-center py-5 text-muted">ยังไม่มีรายการในสถานะนี้</td></tr>}</tbody></table></section>
<div class="d-flex gap-3 mt-3">@if(Model.Page>1){<a asp-action="Index" asp-route-status="@Model.Status" asp-route-page="@(Model.Page-1)">← ก่อนหน้า</a>}<span>หน้า @Model.Page</span>@if(Model.HasNext){<a asp-action="Index" asp-route-status="@Model.Status" asp-route-page="@(Model.Page+1)">ถัดไป →</a>}</div>
<partial name="_TransferDialogs" />
@section Scripts { <script src="~/js/transfers.js" asp-append-version="true"></script> }
