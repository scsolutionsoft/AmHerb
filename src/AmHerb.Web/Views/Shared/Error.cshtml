@model ErrorViewModel
@{
    ViewData["Title"] = "ไม่สามารถแสดงหน้านี้ได้";
}

<h1 class="h3">ไม่สามารถแสดงหน้านี้ได้ชั่วคราว</h1>
<p>กรุณาลองใหม่อีกครั้ง หากยังพบปัญหา โปรดแจ้งผู้ดูแลพร้อมรหัสอ้างอิงด้านล่าง</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>รหัสอ้างอิง:</strong> <code>@Model.RequestId</code>
    </p>
}

<a class="btn btn-outline-success" asp-controller="Home" asp-action="Index">กลับหน้าหลัก</a>
