@model List<Conversation>
@using AmHerb.Web.Controllers
@{ViewData["Title"]="ศูนย์ข้อความ";var staff=(bool)ViewBag.Staff;}
<div class="page-heading"><div><p class="eyebrow">MEMBER CARE</p><h1>ศูนย์ข้อความ</h1><p>ติดตามการติดต่อ สถานะตอบกลับ และประวัติการสนทนา</p></div></div>
<details class="card p-4 mb-4"><summary class="fw-bold">+ @(staff?"ติดต่อสมาชิก":"ส่งข้อความถึงเจ้าหน้าที่")</summary><form asp-action="Send" method="post" class="mt-3"><input type="hidden" name="key" value="@Guid.NewGuid()"/>@if(staff){<label for="chat-member">สมาชิก</label><select class="form-select mb-3" id="chat-member" name="memberId" required>@foreach(var m in (List<Member>)ViewBag.Members){<option value="@m.Id">@m.Code · @m.Name</option>}</select>}<label for="chat-subject">หัวข้อ</label><input class="form-control mb-3" id="chat-subject" name="subject" maxlength="180" required/><label for="chat-body">ข้อความ</label><textarea class="form-control mb-3" id="chat-body" name="body" rows="4" maxlength="4000" required></textarea><button class="btn btn-success">ส่งข้อความ</button></form></details>
<div class="row g-3">@foreach(var c in Model){<div class="col-md-6"><a class="card p-4 text-decoration-none h-100" asp-action="Detail" asp-route-id="@c.Id"><div class="d-flex justify-content-between gap-2"><strong>@c.Subject</strong><span class="badge">@MessagesController.Label(c.Status)</span></div><span class="small text-muted mt-2">@(staff?c.Member.Name:"AM HERB Member Care") · @Bangkok.Format(c.UpdatedAt)</span></a></div>}@if(Model.Count==0){<p class="text-muted">ยังไม่มีการสนทนา เริ่มติดต่อได้จากปุ่มด้านบน</p>}</div>
