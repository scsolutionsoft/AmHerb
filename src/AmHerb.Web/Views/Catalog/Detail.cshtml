@model ProductDetail
@{ ViewData["Title"] = Model.Product.Name; }
<a href="@(Model.Store == null ? "/Catalog" : "/s/" + Model.Store.Slug)" class="text-success">← สินค้าทั้งหมด</a><div class="row g-4 g-lg-5 mt-2 product-detail-layout"><div class="col-lg-7">@await Component.InvokeAsync("ProductGallery",new { productId=Model.Product.Id })</div><div class="col-lg-5 product-detail-copy">
<p class="eyebrow">@Model.Product.Category</p><h1>@Model.Product.Name</h1><p class="lead">@Model.Product.Description</p>
@foreach (var sku in Model.Skus) { <div class="card p-3 my-3"><h2 class="h5">@sku.Variant</h2><p class="price">฿@sku.Price.ToString("N2")</p><form method="post" asp-controller="@(Model.Store == null ? "Cart" : "Storefront")" asp-action="Add" asp-route-slug="@Model.Store?.Slug" class="d-flex gap-2"><input type="hidden" name="skuId" value="@sku.Id" /><input class="form-control quantity" type="number" name="quantity" min="1" max="@sku.Stock" value="1" aria-label="จำนวน" /><button class="btn btn-success" disabled="@(sku.Stock <= 0)">เพิ่มลงตะกร้า</button></form></div> }
<dl class="row small"><dt class="col-4">เลขทะเบียน</dt><dd class="col-8">@(string.IsNullOrEmpty(Model.Product.RegistrationNumber) ? "รอข้อมูลยืนยัน" : Model.Product.RegistrationNumber)</dd><dt class="col-4">ผู้ผลิต</dt><dd class="col-8">@Model.Product.Manufacturer</dd><dt class="col-4">ผู้จัดจำหน่าย</dt><dd class="col-8">@Model.Product.Distributor</dd></dl><div class="alert alert-warning">@Model.Product.Warnings</div>
@if (!string.IsNullOrWhiteSpace(Model.Product.LabelDocumentUrl)) { <a href="@Model.Product.LabelDocumentUrl" rel="noopener">เอกสารฉลากสินค้า</a> }
</div></div>
@if (Model.Store == null && User.Identity?.IsAuthenticated == true)
{
<div class="card p-4 mt-4"><h2 class="h5">สั่งซื้อด้วยราคาสมาชิก / ราคาแพ็ก</h2><p class="small text-muted">ราคา Wholesale และ Pack เป็นการซื้อเพื่อสต็อก ไม่สร้างรางวัลเครือข่าย</p><form method="post" asp-controller="@(Model.Store == null ? "Cart" : "Storefront")" asp-action="Add" asp-route-slug="@Model.Store?.Slug" class="row g-3"><div class="col-md-4"><label class="form-label">สินค้า</label><select name="skuId" class="form-select">@foreach (var s in Model.Skus) { <option value="@s.Id">@s.Code / @s.Variant</option> }</select></div><div class="col-md-3"><label class="form-label">ระดับราคา</label><select name="tier" class="form-select">@foreach (var tier in Model.Prices.Select(x => x.Tier).Distinct()) { <option>@tier</option> }</select></div><div class="col-md-2"><label class="form-label">จำนวนชิ้น/แพ็ก</label><input type="number" name="quantity" min="1" max="1000" value="1" class="form-control" /></div><div class="col-md-3 align-self-end"><button class="btn btn-success">เพิ่มลงตะกร้า</button></div></form></div>
}
@if (Model.Prices.Count > 0) { <h2 class="h4 mt-5">ราคาสมาชิกและแพ็ก</h2><div class="table-responsive"><table class="table"><thead><tr><th>SKU</th><th>ราคา</th><th>จำนวน</th><th>ราคาแพ็ก</th><th>เริ่มใช้ (UTC)</th></tr></thead><tbody>@foreach (var p in Model.Prices) { <tr><td>@p.SkuId</td><td>@p.Tier</td><td>@p.PackQuantity</td><td>@p.Amount.ToString("N2")</td><td>@p.EffectiveFrom.ToString("u")</td></tr> }</tbody></table></div> }


