@model OrderDetail
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{ ViewData["Title"] = Model.Order.Number; var o = Model.Order; }
<div class="page-heading no-print"><h1 class="h3">รายละเอียดคำสั่งซื้อ</h1><div class="d-flex gap-2"><a href="@ViewBag.BackUrl" class="btn btn-outline-success">กลับร้าน / รายการ</a><button type="button" class="btn btn-success" data-print>พิมพ์ใบเสร็จ / ใบจัดสินค้า</button></div></div>
@if(o.StoreId != null) { <div class="alert alert-info">ร้านผู้ขาย: @o.StoreName · จัดส่งจากคลังสมาชิก · ฝ่ายการเงินตรวจรับชำระ</div> } <partial name="_LiveStatus" /><section class="card p-4 p-lg-5 receipt" data-live-region="receipt" data-order-status="@o.Status"><div class="d-flex justify-content-between"><div><p class="brand mb-2">AM HERB</p><h2 class="h5">@(Model.Payment?.Status == "Confirmed" ? "ใบเสร็จรับเงิน / ใบจัดสินค้า" : "ใบสั่งซื้อ")</h2><p class="text-muted small">ไม่ใช่ใบกำกับภาษี</p></div><div class="text-end"><strong>@o.Number</strong><p>@Bangkok.Format(o.CreatedAt)</p><span class="badge status-@o.Status">@MemberLabels.Order(o.Status)</span></div></div><hr />
<div class="row mb-4"><div class="col-sm-6"><strong>@o.CustomerName</strong><p class="mb-1">@o.Phone</p><p>@o.Address</p></div><div class="col-sm-6 text-sm-end"><p>ช่องทาง: @o.Channel</p>@if (!string.IsNullOrEmpty(o.SelectedCarrier)) { <p>ขนส่งที่เลือก: <strong>@o.SelectedCarrier</strong></p> }@if (o.PosSessionId != null) { <p>กะ POS: @o.PosSessionId</p> }<p>ชำระ: @Model.Payment?.Provider</p><p><strong>@MemberLabels.Payment(Model.Payment?.Status)</strong></p></div></div>
<div class="table-responsive"><table class="table"><thead><tr><th>สินค้า</th><th>จำนวน</th><th class="text-end">ราคา/หน่วย</th><th class="text-end">รวม</th></tr></thead><tbody>@foreach (var i in o.Items) { <tr><td><img class="circle-thumb me-2" src="/Media/Thumb/@i.SkuId" alt="@i.Name"/>@i.Name @if (i.ReturnedQuantity > 0) { <small class="text-danger">คืนแล้ว @i.ReturnedQuantity</small> }</td><td>@i.Quantity</td><td class="text-end">@i.UnitPrice.ToString("N2")</td><td class="text-end">@((i.UnitPrice * i.Quantity).ToString("N2"))</td></tr> }</tbody></table></div>
<dl class="receipt-totals"><dt>มูลค่าสินค้า</dt><dd>@o.Merchandise.ToString("N2")</dd><dt>ส่วนลด</dt><dd>@o.Discount.ToString("N2")</dd><dt>ค่าจัดส่ง / ภาษี</dt><dd>@((o.Shipping + o.Tax).ToString("N2"))</dd><dt>Token ใช้แลก</dt><dd>@o.TokenRedemption.ToString("N2") (฿@o.TokenValue.ToString("N2"))</dd><dt class="h5">ยอดชำระ</dt><dd class="h5">฿@o.CashPayable.ToString("N2")</dd>@if (Model.Payment?.Provider == "Cash") { <dt>รับเงินสด</dt><dd>@Model.Payment.Tendered.ToString("N2")</dd><dt>เงินทอน</dt><dd>@Model.Payment.Change.ToString("N2")</dd> }</dl>
@foreach (var s in Model.Shipments) { <p>จัดส่ง @s.Carrier · @s.TrackingNumber · @s.Status</p> }
@if (o.Status == OrderStatus.PendingPayment && Model.Payment?.Status != "Submitted") { <div class="alert alert-info">@Model.PaymentInstructions<br />ยอดชำระ <strong>@o.CashPayable.ToString("N2")</strong> บาท · อ้างอิง <strong>@o.Number</strong></div> }
@if (Model.Payment?.SubmittedReference != null) { <p>เลขอ้างอิงแจ้งโอน: <strong>@Model.Payment.SubmittedReference</strong> · @Bangkok.Format(Model.Payment.SubmittedAt!.Value)</p> }
@if (Model.Payment?.Status == "Submitted") { <p class="alert alert-success">ได้รับข้อมูลแจ้งโอนแล้ว กำลังรอฝ่ายการเงินตรวจสอบ ไม่ต้องโอนซ้ำ</p> }
<p class="small text-muted mt-4 mb-0">AM Token ใช้แลกสินค้าที่ร่วมรายการภายใน AM HERB เท่านั้น ไม่ใช่เงินสด โอนหรือซื้อขายไม่ได้</p></section>
@{ ViewData["SlipRequired"] = ((List<AmHerb.Web.Controllers.SlipRow>)ViewBag.Slips).Count == 0; }
@if (o.Status == OrderStatus.PendingPayment && Model.Payment?.Provider == "ManualBankTransfer") {
<section class="card p-4 mt-3 no-print" data-pending-payment>
<h2 class="h4">4. โอนเงินและแนบสลิป</h2><p>1. โอนตามข้อมูลบัญชีและยอดในใบสั่งซื้อ<br />2. แนบหรือถ่ายรูปสลิป และกรอกเลขอ้างอิงจากธนาคาร<br />3. รอฝ่ายการเงินยืนยัน สถานะอัปเดตทุก 5 วินาที</p>
<form method="post" asp-action="SubmitPayment" enctype="multipart/form-data"><input type="hidden" name="id" value="@o.PublicId" />
<label class="form-label" for="payment-reference">เลขอ้างอิงการโอน</label><input id="payment-reference" name="reference" value="@Model.Payment.SubmittedReference" class="form-control" required maxlength="200" />
<partial name="_SlipUpload" model='@("slip")' /><button class="btn btn-success mt-3">ส่งข้อมูลแจ้งโอน</button></form></section>
}
<section class="card p-4 mt-3 no-print" data-live-region="slips"><h2 class="h5">หลักฐานการชำระเงิน</h2>
@foreach (var slip in (List<AmHerb.Web.Controllers.SlipRow>)ViewBag.Slips) { <div class="d-flex gap-3 align-items-center border-bottom py-2"><button type="button" class="btn btn-outline-success" data-image="/Orders/Slip/@slip.Id" data-caption="สลิป @o.Number · @slip.Reference">ดูภาพสลิป</button><div>@slip.Reference<br /><small>@Bangkok.Format(slip.CreatedAt)</small></div></div> }
@if (((List<AmHerb.Web.Controllers.SlipRow>)ViewBag.Slips).Count == 0) { <p class="text-muted">ยังไม่ได้แนบสลิป@if (o.SlipRequired) { <span> · ต้องแนบก่อนยืนยันรับเงิน</span> }</p> }
</section>
<div data-live-region="finance-review">
@if ((await Authorization.AuthorizeAsync(User, "Payments")).Succeeded && o.Status == OrderStatus.PendingPayment && Model.Payment?.Provider == "ManualBankTransfer") {
<form asp-controller="Admin" asp-action="ConfirmPayment" method="post" class="card p-4 mt-3 no-print"><h2 class="h5">ตรวจรับเงิน (ฝ่ายการเงิน)</h2><p>เปิดภาพสลิปและตรวจยอดเข้าบัญชีจริงก่อนยืนยัน</p><input type="hidden" name="orderId" value="@o.Id" /><label for="finance-reference">เลขอ้างอิงที่ตรวจสอบแล้ว</label><input id="finance-reference" name="reference" value="@Model.Payment.SubmittedReference" class="form-control mb-3" required maxlength="200"/><label for="finance-amount">ยอดรับจริง</label><input id="finance-amount" name="amount" type="number" step="0.01" value="@o.CashPayable.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control mb-3" required/><label for="finance-reason">บันทึกการตรวจสอบ</label><input id="finance-reason" name="reason" class="form-control mb-3" required/><button class="btn btn-success" disabled="@(o.SlipRequired && ((List<AmHerb.Web.Controllers.SlipRow>)ViewBag.Slips).Count == 0)">ยืนยันรับเงิน</button></form>
}
</div>
@if(Model.Payment?.Provider=="TradeCredit"){<div class="alert alert-info" data-live-region="credit-status">รายการซื้อด้วยเครดิตบริษัท · @(Model.Payment.Status=="Confirmed"?"ชำระหนี้ครบแล้ว":"ตรวจสอบยอดหนี้และการชำระในบัญชีเครดิต") <a href="/Credit">ดูบัญชีเครดิต →</a></div>}<div class="no-print mt-4" data-live-region="order-actions">
@if (o.Status == OrderStatus.PendingPayment) { <form method="post" asp-action="Cancel"><input type="hidden" name="id" value="@o.PublicId" /><button class="btn btn-outline-danger">ยกเลิกคำสั่งซื้อ</button></form> }
@if (o.Status is OrderStatus.Delivered or OrderStatus.Completed or OrderStatus.ReturnRequested) { <details class="card p-4 mt-3"><summary>ขอคืนสินค้า</summary><form method="post" asp-action="Return" class="row g-3 mt-1"><div class="col-md-4"><label class="form-label">สินค้า</label><select name="itemId" class="form-select">@foreach (var i in o.Items.Where(x => x.Quantity > x.ReturnedQuantity)) { <option value="@i.Id">@i.Name</option> }</select></div><div class="col-md-2"><label class="form-label">จำนวน</label><input name="quantity" type="number" min="1" value="1" class="form-control" required /></div><div class="col-md-4"><label class="form-label">เหตุผล</label><input name="reason" class="form-control" required maxlength="1000" /></div><div class="col-md-2 align-self-end"><button class="btn btn-outline-danger">ขอคืน</button></div></form></details> }
@if ((await Authorization.AuthorizeAsync(User, "Payments")).Succeeded && o.Status == OrderStatus.Delivered) { <form method="post" asp-controller="Admin" asp-action="VerifyRetail" class="card p-4 mt-3"><h3 class="h5">ยืนยันการขายปลีก</h3><p class="small text-muted">ตรวจสอบหลักฐานการขายจริงและการส่งมอบก่อนยืนยัน ไม่ให้รางวัลซื้อเองหรือซื้อสะสมสต็อก</p><input type="hidden" name="orderId" value="@o.Id" /><input name="reason" class="form-control mb-3" placeholder="หลักฐาน/เหตุผล" required /><button class="btn btn-success">ยืนยันยอดขายและสร้าง Token รอปลดล็อก</button></form> }
@foreach (var r in Model.Returns) { var reduction=((Dictionary<string,decimal>)ViewBag.CreditRefunds).GetValueOrDefault("refund:"+r.Id); <div class="alert alert-light mt-3">คืนสินค้า #@r.Id จำนวน @r.Quantity · @r.Status · ลดหนี้เครดิต @reduction.ToString("N2") บาท · คืนเงิน @((r.CashRefund-reduction).ToString("N2")) บาท / @r.TokensRestored.ToString("N2") Token</div> }
</div>




@section Scripts { <script src="~/js/slip-upload.js" asp-append-version="true"></script> <script src="~/js/member-live.js" asp-append-version="true"></script> }
