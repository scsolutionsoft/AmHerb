@model List<MediaAsset>
@{var first=Model.FirstOrDefault(x=>x.Slot<=4);}
<div class="product-gallery"><button class="gallery-main image-zoom" data-image="@(first==null?"/images/product-placeholder.svg":"/Media/Image/"+first.Id)" data-caption="@(first?.Alt??"AM HERB")"><img src="@(first==null?"/images/product-placeholder.svg":"/Media/Image/"+first.Id)" alt="@(first?.Alt??"AM HERB")"/></button><div class="gallery-thumbs">@foreach(var image in Model.Where(x=>x.Slot<=4)){<button class="image-zoom" data-image="/Media/Image/@image.Id" data-caption="@image.Alt" aria-label="ดูภาพ @image.Slot"><img src="/Media/Image/@image.Id" alt="@image.Alt"/></button>}</div>@foreach(var image in Model.Where(x=>x.Slot==5)){<h2 class="h5 mt-4">ข้อมูลผลิตภัณฑ์</h2><button class="image-zoom gallery-description" data-image="/Media/Image/@image.Id" data-caption="@image.Alt"><img src="/Media/Image/@image.Id" alt="@image.Alt"/></button>}</div>
