@model List<CatalogItem>
@{ViewData["Title"]="AM HERB · ดูแลสุขภาพในทุกวัน"; var featured=Model.FirstOrDefault(x=>x.Code=="CELL-SYNC")??Model.FirstOrDefault();}
<section class="health-hero">
<div class="health-hero-copy"><p class="eyebrow">AM HERB · BALANCE & RESTORE</p><span class="health-kicker">ธรรมชาติ · ความใส่ใจ · สมดุล</span><h1>ดูแลตัวเองวันนี้<br/><span>เพื่อทุกวันที่ดีของคุณ</span></h1><p>เลือกสรรผลิตภัณฑ์สมุนไพรและอาหารเสริม<br class="d-none d-md-block"/> พร้อมข้อมูลที่ช่วยให้คุณเลือกดูแลสุขภาพได้อย่างใส่ใจ</p><a href="#our-products" class="btn btn-success btn-lg">ค้นพบผลิตภัณฑ์ ↗</a><a href="/News" class="health-text-link">ข่าวสารและโปรโมชั่น →</a><div class="hero-footnote">YOUR EVERYDAY WELLNESS</div></div>
@if(featured!=null){<a class="health-hero-art" href="/Catalog/Detail/@featured.Id"><div class="art-heading"><span>PRODUCT SPOTLIGHT</span><span>01 / AM HERB</span></div><img src="@featured.ImageUrl" alt="@featured.Name — ดูข้อมูลผลิตภัณฑ์" fetchpriority="high"/><div class="art-footer"><div><small>รู้จักผลิตภัณฑ์ของเรา</small><h2>@featured.Name</h2></div><span class="round-arrow" aria-hidden="true">↗</span></div></a>}
</section>
<div class="health-service-strip"><div><span class="service-number">01</span><span>เลือกดูผลิตภัณฑ์<small>ภาพและรายละเอียดครบในหน้าเดียว</small></span></div><div><span class="service-number">02</span><span>สั่งซื้ออย่างสะดวก<small>ติดตามสถานะคำสั่งซื้อได้</small></span></div><div><span class="service-number">03</span><span>พร้อมดูแลสมาชิก<small>พูดคุยกับทีมงานผ่านบัญชีของคุณ</small></span></div></div>
<section id="our-products" class="health-products"><div class="health-section-heading"><div><p class="eyebrow">OUR COLLECTION</p><h2>ผลิตภัณฑ์เพื่อการดูแลตัวเอง</h2><p>ทำความรู้จักแต่ละผลิตภัณฑ์ แล้วเลือกสิ่งที่เหมาะกับคุณ</p></div><a href="/Catalog" class="btn btn-outline-success">ดูผลิตภัณฑ์ทั้งหมด →</a></div><div class="row g-4">@foreach(var product in Model.Take(9)){<div class="col-md-6 col-xl-4"><partial name="_HealthProductCard" model="product"/></div>}</div></section>
@await Component.InvokeAsync("ContentFeed")
<section class="health-about"><div class="health-about-photo"><img src="/Media/Brand/2" alt="บรรยากาศ AM HERB Balance & Restore" loading="lazy"/></div><div class="health-about-copy"><p class="eyebrow">GET TO KNOW AM HERB</p><h2>ความใส่ใจเล็ก ๆ<br/>ในทุกวันของคุณ</h2><p>พบกับพื้นที่สำหรับคนที่ใส่ใจสุขภาพ เลือกชมผลิตภัณฑ์ ติดตามข่าวสาร และเชื่อมต่อกับทีมดูแลสมาชิกของเรา</p><a href="/Messages" class="btn btn-outline-success">ติดต่อทีมดูแลสมาชิก →</a><div class="health-about-mini"><img src="/Media/Brand/3" alt="พื้นที่ AM HERB" loading="lazy"/><img src="/Media/Brand/4" alt="ทีมงาน AM HERB" loading="lazy"/><span>BALANCE<br/>& RESTORE</span></div></div></section>
<section class="membership-banner"><div><p class="eyebrow">AM HERB MEMBERSHIP</p><h2>ดูแลสุขภาพ พร้อมสิทธิสำหรับสมาชิก</h2><p class="mb-0">คำสั่งซื้อ ข่าวสาร และสิทธิประโยชน์ รวมไว้ในบัญชีของคุณ</p></div><a href="/Member" class="btn btn-success">พื้นที่สมาชิก →</a></section>
<p class="small text-muted text-center mt-4">อ่านฉลากและคำเตือนของผลิตภัณฑ์ก่อนบริโภค</p>
