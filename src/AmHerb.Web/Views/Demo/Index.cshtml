@model DemoPage
@{ ViewData["Title"] = "ศูนย์ทดลองระบบ AM HERB"; }
<div class="page-heading"><div><p class="eyebrow">AM HERB · SIMULATION LAB</p><h1>ทดลองการทำงานทุกระบบ</h1><p class="text-muted">ใช้ฐานข้อมูล AmHerb บน SQL Server · สถานะชุดข้อมูล: @Model.State</p></div><a class="btn btn-success" href="/Dashboard/Overview">ดูแดชบอร์ดยอดขาย →</a></div>
<div class="row g-3 mb-4">@foreach (var metric in new[] { ("สมาชิกทั้งหมด", Model.Members), ("สินค้า", Model.Products), ("คำสั่งซื้อ", Model.Orders), ("ล็อตสินค้า", Model.Batches) }) { <div class="col-6 col-lg-3"><div class="metric-card compact"><span>@metric.Item1</span><strong>@metric.Item2.ToString("N0")</strong></div></div> }</div>
<div class="alert alert-info">ใช้บัญชีแอดมินเดิมดูภาพรวมและอนุมัติรายการ หรือเข้าสู่ระบบด้วยบัญชีตัวอย่างด้านล่างเพื่อดูข้อมูลส่วนตัว ชื่อ เบอร์โทร ที่อยู่ ยอดเงิน และเลขอ้างอิงทั้งหมดเป็นข้อมูลสมมติ อีเมลจำลองบันทึกไว้ในเครื่อง ไม่ส่งออกภายนอก</div>
<h2 class="h4 mb-3">ตัวอย่างการทำงานแต่ละระบบ</h2><div class="row g-3 mb-5">@foreach (var scenario in Model.Scenarios) { <div class="col-md-6 col-xl-4"><article class="card p-4 h-100"><h3 class="h5">@scenario.Title</h3><p>@scenario.Description</p><small class="text-muted">บัญชี: @scenario.Account</small><p class="small mt-3"><strong>ตรวจสอบ:</strong> @scenario.Expected</p><a class="btn btn-outline-success mt-auto" href="@scenario.Url">เปิดตัวอย่าง →</a></article></div> }</div>
<h2 class="h4">บัญชีสำหรับสลับบทบาท</h2><p class="text-muted">รหัสผ่านของบัญชีจำลองอยู่ในคู่มือที่สร้างในเครื่อง บัญชีแอดมินเดิมใช้รหัสผ่านเดิม</p><div class="card table-responsive mb-5"><table class="table mb-0"><thead><tr><th>อีเมล / Username</th><th>ชื่อ</th><th>สิทธิ์</th></tr></thead><tbody>@foreach (var account in Model.Accounts) { <tr><td>@account.Email</td><td>@account.Name</td><td>@account.Roles</td></tr> }</tbody></table></div>
<section class="card border-danger p-4"><h2 class="h4 text-danger">รีเซ็ตข้อมูลทดสอบ</h2><p>ล้างสมาชิก สต็อก การซื้อขาย เครดิต Token ข้อความ และข้อมูลอื่นที่เพิ่มตั้งแต่เริ่มชุดทดสอบนี้ รวมรายการที่ทดลองเพิ่มผ่านหน้าจอ คงบัญชีแอดมินเดิม สินค้า 9 รายการเดิม รูปภาพ และการตั้งค่าก่อนเริ่มชุดข้อมูลไว้</p><p class="small text-muted">ใช้ได้เฉพาะ SuperAdmin ใน Development หลังรีเซ็ตสามารถสร้างชุดตัวอย่างใหม่ด้วย scripts/Seed-Demo.ps1</p><form asp-action="Reset" method="post" class="d-flex flex-wrap gap-3 align-items-end"><div><label for="demo-reset-confirmation" class="form-label">พิมพ์ RESET DEMO เพื่อยืนยัน</label><input id="demo-reset-confirmation" name="confirmation" class="form-control" autocomplete="off" required pattern="RESET DEMO" /></div><button class="btn btn-danger">ล้างชุดข้อมูลทดสอบ</button></form></section>
