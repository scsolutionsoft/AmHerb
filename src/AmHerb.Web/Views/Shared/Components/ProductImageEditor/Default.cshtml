@model AmHerb.Web.ViewComponents.ProductImageEditorModel
@{var returnUrl=Context.Request.Path+"#product-images";var first=Model.Images.FirstOrDefault(x=>x.Slot<=4)?.Slot;}
<section id="product-images" class="image-editor mt-5"><div class="page-heading"><div><p class="eyebrow">PRODUCT MEDIA</p><h2>รูปภาพสินค้า</h2><p class="text-muted">ภาพสินค้า 1–4 ภาพ และภาพอธิบาย 1 ภาพ · JPEG / PNG / WebP ไม่เกิน 5 MB ต่อภาพ</p></div><span class="badge">@(Model.Images.Count(x=>x.Slot<=4)) / 4 ภาพสินค้า</span></div>
<div class="alert alert-light border">ภาพหลักจะแสดงในหน้าร้านและรายการต่าง ๆ เลือกตำแหน่งเพื่อสลับลำดับได้ ข้อมูลสินค้าและรูปภาพมีปุ่มบันทึกแยกกัน</div>
<div class="row g-4">@for(var slot=1;slot<=5;slot++){var current=Model.Images.SingleOrDefault(x=>x.Slot==slot);
<div class="col-md-6 col-xl-4"><article class="card p-4 h-100 image-edit-card" data-image-card><div class="d-flex justify-content-between gap-2 mb-3"><h3 class="h5 mb-0">@(slot==5?"ภาพอธิบายข้อมูลสินค้า":"ภาพสินค้า "+slot)</h3>@if(first==slot){<span class="badge text-bg-success">ภาพหลัก</span>}</div>
@if(current!=null){<button type="button" class="image-zoom border-0 bg-transparent p-0" data-image="/Media/Image/@current.Id" data-caption="@current.Alt" aria-label="ขยายภาพสินค้า @slot"><img class="upload-preview" src="/Media/Image/@current.Id" alt="@current.Alt"/></button>
<form asp-controller="Media" asp-action="Caption" method="post" class="mt-3"><input type="hidden" name="id" value="@current.Id"/><input type="hidden" name="returnUrl" value="@returnUrl"/><label for="caption-@slot">คำอธิบายภาพปัจจุบัน</label><input id="caption-@slot" name="alt" value="@current.Alt" maxlength="200" class="form-control"/><button class="btn btn-outline-success btn-sm mt-2">บันทึกคำอธิบาย</button></form>
@if(slot<=4){<form asp-controller="Media" asp-action="Move" method="post" class="mt-3"><input type="hidden" name="id" value="@current.Id"/><input type="hidden" name="returnUrl" value="@returnUrl"/><label for="position-@slot">ตำแหน่งภาพ</label><div class="d-flex gap-2"><select name="slot" id="position-@slot" class="form-select">@for(var target=1;target<=4;target++){<option value="@target" selected="@(slot==target)">@(target==1?"1 · ภาพหลัก":target.ToString())</option>}</select><button class="btn btn-outline-success">สลับ</button></div></form>}
<form asp-controller="Media" asp-action="Delete" method="post" class="mt-2" data-confirm-delete><input type="hidden" name="id" value="@current.Id"/><input type="hidden" name="returnUrl" value="@returnUrl"/><button class="btn btn-link text-danger px-0">ลบภาพนี้</button></form>
}else{<div class="image-empty"><span aria-hidden="true">＋</span><p>ยังไม่มีภาพ</p></div>}
<form asp-controller="Media" asp-action="Upload" method="post" enctype="multipart/form-data" class="mt-auto pt-3 border-top" data-image-upload><input type="hidden" name="productId" value="@Model.ProductId"/><input type="hidden" name="slot" value="@slot"/><input type="hidden" name="returnUrl" value="@returnUrl"/><label for="file-@slot">@(current==null?"เพิ่มภาพใหม่":"เลือกภาพเพื่อแทนที่")</label><input class="form-control mb-2" type="file" id="file-@slot" name="file" accept="image/png,image/jpeg,image/webp" required data-image-file/><div class="image-upload-status small" role="status" aria-live="polite"></div><img class="upload-preview my-2" data-local-preview hidden alt="ตัวอย่างภาพที่เลือก ยังไม่ได้บันทึก"/><label for="alt-@slot">คำอธิบายภาพใหม่</label><input class="form-control mb-3" id="alt-@slot" name="alt" maxlength="200" value="@(current?.Alt??Model.Name)"/><button class="btn btn-success w-100">@(current==null?"เพิ่มภาพ":"แทนที่ภาพ")</button></form>
</article></div>
}</div></section>
