@model ValueTuple<TreeNode, IReadOnlyList<TreeNode>>
@{ var node = Model.Item1; var children = Model.Item2.Where(x => x.ParentId == node.Id).ToArray(); }
<details class="tree-node" open="@(node.Depth == 0)"><summary><strong>@node.Name</strong> <small class="text-muted">@node.Code · @node.Status · @children.Length คน</small></summary>
@foreach (var child in children) { <partial name="_TreeNode" model="(child, Model.Item2)" /> }
</details>
