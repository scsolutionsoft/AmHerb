@model StockTransfer
@{ Layout = null; var type = (string)ViewBag.DocumentType; var title = type == "po" ? "ใบสั่งซื้อ / PURCHASE ORDER" : type == "dispatch" ? "ใบส่งสินค้า / DELIVERY NOTE" : "ใบรับสินค้า / GOODS RECEIPT"; var number = type == "po" ? Model.PoNumber : (type == "dispatch" ? $"DN-{Model.Id:D8}" : $"GR-{Model.Id:D8}"); }
<!doctype html><html lang="th"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>@number</title><style>@@page{size:A4;margin:14mm}*{box-sizing:border-box}body{font:14px system-ui,"Noto Sans Thai",sans-serif;color:#17251d;margin:0}.toolbar{display:flex;gap:8px;justify-content:flex-end;margin-bottom:16px}.toolbar button{padding:9px 16px;border:0;border-radius:8px;background:#176b45;color:#fff}.head{display:flex;justify-content:space-between;border-bottom:3px solid #176b45;padding-bottom:14px}.brand{font-size:24px;font-weight:800;color:#176b45}.title{text-align:right}.title h1{font-size:22px;margin:0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:20px 0}.box{border:1px solid #b8c9bf;border-radius:10px;padding:14px}.muted{color:#60736a;font-size:12px}table{width:100%;border-collapse:collapse}th,td{border-bottom:1px solid #ccd8d1;padding:10px;text-align:left}.num{text-align:right}.totals{margin:18px 0 0 auto;width:320px}.signatures{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:55px;text-align:center}.line{border-top:1px solid #444;padding-top:7px}.note{margin-top:20px;padding:12px;background:#f4f8f5;border-radius:8px}@@media print{.toolbar{display:none}}</style></head><body>
<div class="toolbar"><button onclick="window.print()">พิมพ์ / บันทึก PDF</button></div><header class="head"><div><div class="brand">AMHERB</div><div class="muted">ระบบบริหารคลังและเครือข่ายสมาชิก</div></div><div class="title"><h1>@title</h1><strong>@number</strong><div class="muted">วันที่ @Bangkok.Format(Model.CreatedAt)</div></div></header>
<div class="grid"><section class="box"><div class="muted">ผู้ส่ง / คลังต้นทาง</div><strong>@Model.SourceWarehouse.Name</strong>@if(Model.SourceWarehouse.OwnerMember != null){<div>สมาชิก #@Model.SourceWarehouse.OwnerMemberId</div>}</section><section class="box"><div class="muted">ผู้รับ / คลังปลายทาง</div><strong>@Model.DestinationWarehouse.Name</strong>@if(Model.DestinationWarehouse.OwnerMember != null){<div>สมาชิก #@Model.DestinationWarehouse.OwnerMemberId</div>}</section></div>
<table><thead><tr><th>รหัส / รายการ</th><th class="num">จำนวน</th>@if(type=="po"){<th class="num">ราคา/ชิ้น</th><th class="num">รวม</th>}else{<th>ล็อต / หมดอายุ</th>}</tr></thead><tbody><tr><td><strong>@Model.Sku.Code</strong><br />@Model.Sku.Product.Name</td><td class="num">@Model.Quantity.ToString("N0") ชิ้น</td>@if(type=="po"){<td class="num">@Model.UnitPrice.ToString("N2")</td><td class="num">@Model.ChargeAmount.ToString("N2")</td>}else{<td>@foreach(var a in Model.Allocations){<div>@a.SourceBatch.LotNo · @a.SourceBatch.ExpDate.ToString("dd/MM/yyyy") · @a.Quantity ชิ้น</div>}</td>}</tr></tbody></table>
@if(type=="po"){<table class="totals"><tr><th>ยอดเรียกเก็บ</th><td class="num"><strong>@Model.ChargeAmount.ToString("N2") บาท</strong></td></tr><tr><th>รับชำระแล้ว</th><td class="num">@Model.PaidAmount.ToString("N2") บาท</td></tr><tr><th>วิธีชำระ</th><td class="num">@Model.PaymentMethod</td></tr><tr><th>สถานะการเงิน</th><td class="num">@Model.FinancialStatus</td></tr></table>}
<div class="note"><strong>อ้างอิง:</strong> @(string.IsNullOrWhiteSpace(Model.Tracking) ? "—" : Model.Tracking)<br /><strong>เหตุผล/หมายเหตุ:</strong> @Model.Reason</div><div class="signatures"><div class="line">ผู้จัดทำ / วันที่</div><div class="line">ผู้อนุมัติ/ผู้ส่ง / วันที่</div><div class="line">ผู้รับ / วันที่</div></div>
</body></html>
