@model CatalogItem
<article class="card product-card health-product-card h-100"><a class="product-visual" href="/Catalog/Detail/@Model.Id"><img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy"/></a><div class="card-body"><p class="product-category">@Model.Category</p><h2 class="h5"><a href="/Catalog/Detail/@Model.Id">@Model.Name</a></h2><p class="product-variant">@Model.Variant · @Model.Code</p><div class="product-price-row"><strong class="price">฿@Model.Price.ToString("N2")</strong><span class="product-token">@Model.BaseToken.ToString("N0") Base Token</span></div><a href="/Catalog/Detail/@Model.Id" class="btn btn-outline-success w-100 mt-3">ดูรายละเอียดผลิตภัณฑ์ ↗</a></div></article>
