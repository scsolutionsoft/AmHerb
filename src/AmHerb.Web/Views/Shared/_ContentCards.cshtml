@model List<ContentPost>
<div class="row g-4 content-feed">@foreach(var post in Model){<article class="col-md-6 col-xl-4"><div class="card h-100 overflow-hidden">@if(post.MediaAssetId!=null){<button class="image-zoom border-0 p-0" data-image="/Media/Image/@post.MediaAssetId" data-caption="@post.Title"><img class="campaign-image" src="/Media/Image/@post.MediaAssetId" alt="@post.Title" loading="lazy"/></button>}<div class="p-4"><span class="badge mb-3">@(post.Kind==ContentKind.News?"ข่าวสาร":"โปรโมชั่น") · @(post.Audience==ContentAudience.Members?"สำหรับสมาชิก":"AM HERB")</span><h2 class="h4">@post.Title</h2><p class="content-body">@post.Body</p><p class="small text-muted">@post.StartsAt.AddHours(7).ToString("dd/MM/yyyy") – @post.EndsAt.AddHours(7).ToString("dd/MM/yyyy")</p>@if(!string.IsNullOrEmpty(post.Link)){<a class="btn btn-outline-success" href="@post.Link">ดูรายละเอียด →</a>}</div></div></article>}@if(Model.Count==0){<p class="text-muted py-4">ยังไม่มีประกาศในช่วงเวลานี้</p>}</div>
