@model ContentPost
@{ViewData["Title"]="แก้ไขประกาศ";}
<h1 class="h2 mb-4">@(Model.Id==0?"สร้างข่าว / โฆษณา":"แก้ไขประกาศ")</h1>
<form asp-action="Save" method="post" enctype="multipart/form-data" class="card p-4"><input type="hidden" name="id" value="@(Model.Id==0?"":Model.Id.ToString())"/><input type="hidden" name="version" value="@Convert.ToBase64String(Model.RowVersion)"/><div class="row g-3"><div class="col-12"><label for="news-title">หัวข้อ</label><input class="form-control" id="news-title" name="title" value="@Model.Title" maxlength="180" required/></div><div class="col-md-6"><label for="news-kind">ประเภท</label><select class="form-select" id="news-kind" name="kind"><option value="News" selected="@(Model.Kind==ContentKind.News)">ข่าวสาร</option><option value="Advertisement" selected="@(Model.Kind==ContentKind.Advertisement)">โฆษณา / โปรโมชั่น</option></select></div><div class="col-md-6"><label for="news-audience">กลุ่มผู้ชม</label><select class="form-select" id="news-audience" name="audience"><option value="Public" selected="@(Model.Audience==ContentAudience.Public)">บุคคลทั่วไปที่ยังไม่เข้าสู่ระบบ</option><option value="Members" selected="@(Model.Audience==ContentAudience.Members)">สมาชิกที่เข้าสู่ระบบ</option><option value="Everyone" selected="@(Model.Audience==ContentAudience.Everyone)">ทุกคน</option></select></div><div class="col-md-6"><label for="news-start">เริ่มเผยแพร่ (เวลาไทย)</label><input class="form-control" type="datetime-local" id="news-start" name="startsAt" value="@Model.StartsAt.AddHours(7).ToString("yyyy-MM-ddTHH:mm")" required/></div><div class="col-md-6"><label for="news-end">สิ้นสุด (เวลาไทย)</label><input class="form-control" type="datetime-local" id="news-end" name="endsAt" value="@Model.EndsAt.AddHours(7).ToString("yyyy-MM-ddTHH:mm")" required/></div><div class="col-12"><label for="news-body">เนื้อหา</label><textarea class="form-control" rows="6" id="news-body" name="body" maxlength="6000">@Model.Body</textarea></div><div class="col-md-6"><label for="news-image">ภาพโฆษณา (เก็บในฐานข้อมูล)</label><input class="form-control" type="file" id="news-image" name="image" accept="image/png,image/jpeg,image/webp"/>@if(Model.MediaAssetId!=null){<img class="upload-preview mt-2" src="/Media/Image/@Model.MediaAssetId" alt="@Model.Title"/>}</div><div class="col-md-6"><label for="news-link">ลิงก์ภายในเว็บไซต์</label><input class="form-control" id="news-link" name="link" value="@Model.Link" maxlength="300"/><label class="d-block my-3"><input type="checkbox" name="published" value="true" checked="@Model.Published"/> เปิดเผยแพร่ตามเวลาที่กำหนด</label></div><div class="col-12"><label for="news-reason">เหตุผลการบันทึก</label><input class="form-control" name="reason" id="news-reason" maxlength="500" required/></div><div class="col-12"><button class="btn btn-success">บันทึกประกาศ</button><a class="btn btn-light ms-2" asp-action="Manage">กลับ</a></div></div></form>
