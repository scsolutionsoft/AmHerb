@model CartModel
<div class="card p-4"><h2 class="h4">สั่งซื้อทีละขั้นตอน</h2><p class="small text-muted">กรอกผู้รับ → เลือกที่อยู่และขนส่ง → ตรวจสอบ → โอนและแนบสลิป</p>
<form method="post" asp-action="Checkout" asp-route-slug="@Model.Store?.Slug" data-checkout-wizard novalidate>
<input asp-for="Checkout.Key" type="hidden" />
<ol class="list-unstyled d-flex flex-wrap gap-2 small mb-4" aria-label="ขั้นตอนซื้อ"><li class="rounded border px-2 py-1" data-step-label>1. ผู้รับ</li><li class="rounded border px-2 py-1" data-step-label>2. จัดส่ง</li><li class="rounded border px-2 py-1" data-step-label>3. ตรวจสอบ</li></ol>
<fieldset data-checkout-step><legend class="h5">1. ข้อมูลผู้รับสินค้า</legend>
<label asp-for="Checkout.CustomerName" class="form-label">ชื่อผู้รับ</label><input asp-for="Checkout.CustomerName" class="form-control mb-3" autocomplete="shipping name" maxlength="160" required />
<label asp-for="Checkout.Phone" class="form-label">เบอร์โทรศัพท์</label><input asp-for="Checkout.Phone" class="form-control mb-3" type="tel" autocomplete="shipping tel" maxlength="40" required />
<label asp-for="Checkout.Email" class="form-label">อีเมล (ถ้ามี)</label><input asp-for="Checkout.Email" class="form-control mb-3" type="email" autocomplete="email" />
<button type="button" class="btn btn-success w-100" data-next>ถัดไป: ที่อยู่จัดส่ง</button></fieldset>
<fieldset data-checkout-step><legend class="h5">2. ที่อยู่และผู้ขนส่ง</legend>
<label asp-for="Checkout.HouseNumber" class="form-label">บ้านเลขที่ / ห้อง / อาคาร</label><input asp-for="Checkout.HouseNumber" class="form-control mb-3" maxlength="100" required />
<button type="button" class="btn btn-outline-success w-100 mb-2" data-bs-toggle="modal" data-bs-target="#address-picker">เลือกจังหวัด อำเภอ ตำบล หมู่บ้าน</button>
<p class="small" data-address-summary role="status">ยังไม่ได้เลือกพื้นที่จัดส่ง</p>
<label asp-for="Checkout.VillageName" class="form-label">หมู่บ้าน / หมู่ที่ (กรณีไม่พบในรายการ)</label><input asp-for="Checkout.VillageName" class="form-control mb-3" maxlength="160" />
<label asp-for="Checkout.AddressExtra" class="form-label">ซอย ถนน จุดสังเกต (ถ้ามี)</label><input asp-for="Checkout.AddressExtra" class="form-control mb-3" maxlength="300" />
<label asp-for="Checkout.PostalCode" class="form-label">รหัสไปรษณีย์</label><select asp-for="Checkout.PostalCode" class="form-select mb-3" required><option value="">เลือกพื้นที่ก่อน</option></select>
<label asp-for="Checkout.ShippingProviderId" class="form-label">ผู้ให้บริการจัดส่ง</label><select asp-for="Checkout.ShippingProviderId" class="form-select mb-3" required><option value="">เลือกขนส่ง</option>@foreach (var carrier in Model.Carriers) { <option value="@carrier.Id">@carrier.Name</option> }</select>
@if (Model.Carriers.Count == 0) { <p class="alert alert-warning">ร้านยังไม่เปิดบริการจัดส่ง กรุณาติดต่อร้าน</p> }
<div class="d-flex gap-2"><button type="button" class="btn btn-outline-success" data-back>ย้อนกลับ</button><button type="button" class="btn btn-success flex-grow-1" data-next>ถัดไป: ตรวจสอบ</button></div>
</fieldset>
<fieldset data-checkout-step><legend class="h5">3. ตรวจสอบก่อนสั่งซื้อ</legend><div class="alert alert-light" data-checkout-summary></div>
@if (Model.Store == null) { <label asp-for="Checkout.Coupon" class="form-label">รหัสคูปอง</label><input asp-for="Checkout.Coupon" class="form-control mb-3" /><label class="d-block mb-3"><input asp-for="Checkout.StockLoading" /> ซื้อเพื่อขายต่อ / เติมสต็อก</label> }
@if (Model.Wallet != null) { <p>Token พร้อมใช้ @Model.Wallet.Available.ToString("N2")</p><label asp-for="Checkout.Tokens">Token ที่ต้องการใช้</label><input asp-for="Checkout.Tokens" class="form-control mb-3" type="number" min="0" step="0.01" /> }
@if (Model.CreditAvailable != null) { <label class="d-block my-3"><input asp-for="Checkout.UseCredit" /> ใช้เครดิตบริษัท (คงเหลือ @Model.CreditAvailable.Value.ToString("N2") บาท)</label> }
<p class="small">ยอดสุดท้ายจะแสดงในใบสั่งซื้อก่อนโอนเงิน จากนั้นแนบสลิปเพื่อให้ฝ่ายการเงินตรวจสอบ ร้านจะเริ่มจัดส่งเมื่อยืนยันรับเงินแล้ว</p>
<div class="d-flex gap-2"><button type="button" class="btn btn-outline-success" data-back>แก้ไขที่อยู่</button><button class="btn btn-success flex-grow-1" type="submit">ยืนยันคำสั่งซื้อ</button></div>
</fieldset>
<div class="modal fade" id="address-picker" tabindex="-1" aria-labelledby="address-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h3 id="address-title" class="modal-title h5">เลือกพื้นที่จัดส่ง</h3><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button></div><div class="modal-body">
<label for="address-province">จังหวัด</label><select id="address-province" class="form-select mb-3"><option value="">เลือกจังหวัด</option>@foreach (var p in ThaiAddresses.Children(null)) { <option value="@p.Id">@p.Name</option> }</select>
<label for="address-district">อำเภอ / เขต</label><select id="address-district" class="form-select mb-3" disabled><option value="">เลือกจังหวัดก่อน</option></select>
<label asp-for="Checkout.SubdistrictCode">ตำบล / แขวง</label><select asp-for="Checkout.SubdistrictCode" class="form-select mb-3" disabled><option value="">เลือกอำเภอก่อน</option></select>
<label asp-for="Checkout.VillageCode">หมู่บ้าน / ชุมชน</label><select asp-for="Checkout.VillageCode" class="form-select mb-3" disabled><option value="">ไม่ระบุ / กรอกเอง</option></select>
<p class="small text-muted">หากไม่มีหมู่บ้าน เช่น เขตเมืองหรือคอนโด ให้กรอกอาคารและรายละเอียดที่อยู่ในหน้าจัดส่ง</p><p data-address-error class="small text-danger" role="alert"></p>
<small>ข้อมูล <a href="https://github.com/open-admin-data/thailand-administrative-divisions" target="_blank" rel="noopener">Open Admin Data</a> · CC BY 4.0</small>
</div><div class="modal-footer"><button type="button" class="btn btn-success" data-address-confirm>ใช้พื้นที่นี้</button></div></div></div></div>
</form></div>
