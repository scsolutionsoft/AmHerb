<div class="modal fade" id="transfer-product-modal" tabindex="-1" aria-labelledby="transfer-product-title"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="transfer-product-title">รายละเอียดสินค้าในคลัง</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button></div><div class="modal-body"><div class="d-flex gap-3 mb-3"><img id="transfer-product-image" width="80" height="80" class="rounded" alt="ภาพสินค้า" /><div style="min-width:0;overflow-wrap:anywhere"><strong id="transfer-product-name"></strong><p id="transfer-product-description" class="small text-muted"></p></div></div><p id="transfer-lot-caption"></p><div class="table-responsive"><table class="table"><thead><tr><th>ล็อต</th><th>หมดอายุ</th><th>พร้อมโอน</th><th>จอง</th><th>ใช้ไม่ได้</th></tr></thead><tbody id="transfer-lot-rows"></tbody></table></div></div></div></div></div>
<div class="modal fade" id="transfer-confirm-modal" tabindex="-1" aria-labelledby="transfer-confirm-title"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 id="transfer-confirm-title" class="modal-title h5">ตรวจสอบและยืนยัน</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button></div><div class="modal-body"><p id="transfer-confirm-summary" style="white-space:pre-line;overflow-wrap:anywhere"></p><p id="transfer-confirm-impact" class="alert alert-info"></p><label id="transfer-receive-check" hidden><input type="checkbox" id="transfer-counted" /> ตรวจนับครบจำนวนและล็อตตรงตามใบส่งของแล้ว</label><p class="small text-muted">ระบบตรวจสิทธิ์ สถานะ และยอดล่าสุดอีกครั้งขณะบันทึก</p></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">กลับไปตรวจข้อมูล</button><button class="btn btn-success" id="transfer-confirm-save" type="button">ยืนยันดำเนินการ</button></div></div></div></div>
@if(TempData.Peek("Success") is string notice) { <div class="modal fade" id="transfer-notice-modal" tabindex="-1" aria-labelledby="transfer-notice-title"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 id="transfer-notice-title" class="modal-title h5">อัปเดตการโอนสินค้าแล้ว</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button></div><div class="modal-body"><p>@notice</p></div><div class="modal-footer"><button type="button" class="btn btn-success" data-bs-dismiss="modal">รับทราบ</button></div></div></div></div> }
