@model MemberDashboard
@{ ViewData["Title"] = "พื้นที่สมาชิก"; }
<div class="page-heading"><button class="btn btn-outline-success no-print" data-print>พิมพ์ข้อมูลหน้านี้</button><div><p class="eyebrow">YOUR AM HERB</p><h1>สวัสดี @Model.Member.Name</h1><p class="text-muted">@Model.Member.Code · @Model.Member.Type</p></div><a class="btn btn-success" href="/Pos">เปิดหน้าขาย POS →</a></div>
@if (Model.Member.ReviewRequired) { <div class="alert alert-warning">บัญชีต้องตรวจสอบยอด Token หากยอดพร้อมใช้ติดลบจะไม่สามารถแลกสินค้าเพิ่มได้</div> }
@if (TempData["PosConsent"] is string consentCode) { <div class="alert alert-success">รหัสอนุมัติ POS ของคุณ: <strong class="font-monospace">@consentCode</strong><br />ให้เฉพาะแคชเชียร์จุดขายที่เลือก ใช้ได้ครั้งเดียวภายใน 5 นาที</div> }
<details class="card p-3 mb-4"><summary>อนุมัติใช้ Token ที่ POS</summary><form asp-action="AuthorizeRedemption" method="post" class="row g-3 mt-1"><div class="col-md-4"><label class="form-label">รหัสจุดขาย POS (สอบถามแคชเชียร์)</label><input name="registerId" type="number" min="1" class="form-control" required /></div><div class="col-md-4"><label class="form-label">อนุมัติ Token สูงสุด</label><input name="tokens" type="number" min="0.01" step="0.01" class="form-control" required /></div><div class="col-md-4 align-self-end"><button class="btn btn-outline-success">สร้างรหัสอนุมัติ 5 นาที</button></div></form></details>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric-card featured"><span>Token พร้อมใช้</span><strong>@Model.Wallet.Available.ToString("N2")</strong><a href="/Catalog">เลือกสินค้าเพื่อแลก →</a></div></div><div class="col-md-4"><div class="metric-card"><span>Token รอปลดล็อก</span><strong>@Model.Wallet.Pending.ToString("N2")</strong><small>รอครบกำหนดตามนโยบายการขาย</small></div></div><div class="col-md-4"><div class="metric-card"><span>Token จองชำระ</span><strong>@Model.Wallet.Reserved.ToString("N2")</strong><small>สำหรับคำสั่งซื้อที่ยังไม่ชำระ</small></div></div></div>
<div class="row g-3 mb-4">@foreach (var metric in new[] { ("ยอดขายส่วนตัว", Model.PersonalSales.ToString("N2")), ("ยอดขายทีม", Model.TeamSales.ToString("N2")), ("สมาชิกแนะนำโดยตรง", Model.DirectDownlines.ToString()), ("เครือข่ายที่ใช้งาน", Model.ActiveDownlines.ToString()) }) { <div class="col-6 col-lg-3"><div class="metric-card compact"><span>@metric.Item1</span><strong>@metric.Item2</strong></div></div> }</div>
<ul class="nav nav-pills gap-2 mb-4" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#wallet" type="button">Wallet / Statement</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#orders" type="button">คำสั่งซื้อ / ยอดขาย</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#network" type="button">เครือข่าย / แนะนำ</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile" type="button">โปรไฟล์</button></li></ul>
<div class="tab-content"><section class="tab-pane fade show active" id="wallet"><div class="card p-4"><h2 class="h4">ประวัติ Token</h2><p class="small text-muted">เครดิตสำหรับแลกสินค้า AM HERB ไม่สามารถถอนเงิน โอนให้สมาชิกอื่น หรือซื้อขายภายนอก</p><div class="table-responsive"><table class="table"><thead><tr><th>วัน/เวลา</th><th>รายการ</th><th>Pending</th><th>Available</th><th>Reserved</th><th>สถานะ</th></tr></thead><tbody>@foreach (var l in Model.Ledger) { <tr><td>@Bangkok.Format(l.PostedAt)</td><td>@l.Kind</td><td class="text-warning-emphasis">@l.PendingDelta.ToString("N2")</td><td class="text-success">@l.AvailableDelta.ToString("N2")</td><td>@l.ReservedDelta.ToString("N2")</td><td><span class="badge status-@l.Status">@l.Status</span></td></tr> }@if (Model.Ledger.Count == 0) { <tr><td colspan="6" class="text-center py-4 text-muted">ยังไม่มีรายการ Token</td></tr> }</tbody></table></div></div></section>
<section class="tab-pane fade" id="orders"><h2 class="h4">คำสั่งซื้อ / POS ของฉัน</h2><partial name="_OrderTable" model="Model.Orders.Where(x => x.BuyerMemberId == Model.Member.Id || x.CashierUserId == Model.Member.UserId)" /><h2 class="h4 mt-4">ยอดขายจากการแนะนำ</h2><table class="table"><thead><tr><th>รายการ</th><th>เวลา</th><th>ยอดสินค้า</th><th>สถานะ</th></tr></thead><tbody>@foreach (var o in Model.Orders.Where(x => x.SellerMemberId == Model.Member.Id)) { <tr><td>@o.Number</td><td>@Bangkok.Format(o.CreatedAt)</td><td>@((o.Merchandise - o.Discount).ToString("N2"))</td><td>@o.Status</td></tr> }</tbody></table></section>
<section class="tab-pane fade" id="network"><div class="row g-4"><div class="col-lg-5"><div class="card p-4"><h2 class="h4">ลิงก์แนะนำของฉัน</h2><img class="qr my-3" src="/Member/Qr" alt="QR ลิงก์แนะนำของคุณ" /><label class="form-label" for="ref-link">แชร์ลิงก์สินค้า</label><input id="ref-link" class="form-control" value="@Model.ReferralUrl" readonly /><a class="btn btn-outline-success mt-3" href="/Member/Qr" download="amherb-referral.png">ดาวน์โหลด QR</a><p class="small text-muted mt-3">รางวัลมาจากยอดขายปลีกจริง ไม่มีรางวัลจากการสมัครสมาชิก</p></div></div><div class="col-lg-7"><div class="card p-4"><h2 class="h4">เครือข่ายสมาชิก</h2><p class="small text-muted">@string.Join(" → ", Model.Upline.Select(x => x.Code))</p>@foreach (var root in Model.Tree.Where(x => x.Id == Model.Member.Id)) { <partial name="_TreeNode" model="(root, Model.Tree)" /> }</div></div></div></section>
<section class="tab-pane fade" id="profile"><div class="card p-4"><h2 class="h4">ข้อมูลส่วนตัว</h2><form asp-action="Profile" method="post" class="row g-3"><div class="col-md-6"><label class="form-label">ชื่อ-นามสกุล</label><input name="name" value="@Model.Member.Name" class="form-control" required maxlength="160" /></div><div class="col-md-6"><label class="form-label">เบอร์โทร</label><input name="phone" value="@Model.Member.Phone" class="form-control" maxlength="40" /></div><div class="col-12"><label class="form-label">ที่อยู่</label><textarea name="address" class="form-control" maxlength="1000">@Model.Member.Address</textarea></div><div><button class="btn btn-success">บันทึกโปรไฟล์</button> <a href="/Identity/Account/Manage" class="btn btn-outline-success">รหัสผ่าน / MFA / อีเมล</a></div></form></div></section></div>
<h2 class="h4 mt-5">การแจ้งเตือน</h2><div class="list-group">@foreach (var n in Model.Notifications) { <div class="list-group-item d-flex justify-content-between gap-3"><div><small class="text-muted">@Bangkok.Format(n.CreatedAt)</small><p class="mb-0">@n.Message</p></div>@if (!n.Read) { <form method="post" asp-action="Read"><input type="hidden" name="id" value="@n.Id" /><button class="btn btn-sm btn-outline-success">อ่านแล้ว</button></form> }</div> }</div>
@await Component.InvokeAsync("ContentFeed")

