@model ClearingPage
@{ ViewData["Title"] = "ติดตามเคลียร์ยอดสมาชิก"; }
<h1>ติดตามเคลียร์ยอดสมาชิก</h1><partial name="_OperationsNav" /><p class="text-muted">ตรวจหลักฐานรับชำระในบัญชีเครดิตแต่ละราย ยอดจะลดเมื่อฝ่ายการเงินยืนยันสำเร็จ</p><form method="get" class="card p-3 mb-3"><label for="clear-q">รหัส / ชื่อสมาชิก</label><input id="clear-q" name="q" value="@Model.Q" class="form-control mb-2" /><label class="mb-2"><input type="checkbox" name="overdue" value="true" checked="@Model.OverdueOnly" /> เฉพาะหนี้เกินกำหนด</label><button class="btn btn-success align-self-start">กรองรายการ</button></form>
<partial name="_LiveStatus" /><div data-live-region="clearing"><div class="row g-3 mb-4">@foreach(var item in new[] { ("หนี้คงค้าง", Model.Balance.ToString("N2") + " บาท"), ("เกินกำหนด", Model.Overdue.ToString("N2") + " บาท"), ("หลักฐานรอตรวจ", Model.PendingReceipts.ToString("N0") + " รายการ") }) { <div class="col-md-4"><div class="metric-card"><span>@item.Item1</span><strong class="fs-4">@item.Item2</strong></div></div> }</div><p class="small">ยอดสรุปครอบคลุมทุกบัญชีที่ตรงตัวกรอง ไม่ใช่เฉพาะหน้านี้</p><div class="card table-responsive"><table class="table"><thead><tr><th>สมาชิก</th><th>หนี้คงค้าง</th><th>เกินกำหนด</th><th>รอตรวจ</th><th>ดำเนินการ</th></tr></thead><tbody>@foreach(var r in Model.Rows) { <tr><td><a href="/Operations/Member/@r.MemberId">@r.Code · @r.Name</a></td><td>@r.Balance.ToString("N2")</td><td class="@(r.Overdue > 0 ? "text-danger" : "")">@r.Overdue.ToString("N2")</td><td>@r.PendingReceipts</td><td><a href="/Credit/Account/@r.Id">ตรวจและเคลียร์ยอด →</a></td></tr> }@if(Model.Rows.Count == 0) { <tr><td colspan="5">ไม่พบบัญชีตรงตัวกรอง</td></tr> }</tbody></table></div><nav class="d-flex gap-3 my-3">@if(Model.Page > 1) { <a asp-action="Clearing" asp-route-q="@Model.Q" asp-route-overdue="@Model.OverdueOnly" asp-route-page="@(Model.Page - 1)">ก่อนหน้า</a> }@if(Model.Page * 50 < Model.Total) { <a asp-action="Clearing" asp-route-q="@Model.Q" asp-route-overdue="@Model.OverdueOnly" asp-route-page="@(Model.Page + 1)">ถัดไป</a> }</nav>
<section class="card p-4 mt-4"><h2 class="h5">ผลต่างปิดกะ POS ที่ต้องตรวจ</h2><p class="small text-muted">แสดงล่าสุด 30 กะตามคำค้นสมาชิก ไม่ใช่หนี้เครดิต และยังไม่มีสถานะปิดเคสผลต่างในระบบ</p><div class="table-responsive"><table class="table"><thead><tr><th>กะ / จุดขาย</th><th>ปิดเมื่อ</th><th>คาดว่ามี</th><th>นับจริง</th><th>ผลต่าง</th></tr></thead><tbody>@foreach(var p in Model.PosDifferences) { <tr><td>#@p.Id · @p.PosRegister.Name</td><td>@Bangkok.Format(p.ClosedAt!.Value)</td><td>@p.ExpectedCash?.ToString("N2")</td><td>@p.CountedCash?.ToString("N2")</td><td>@p.Difference?.ToString("N2")</td></tr> }@if(Model.PosDifferences.Count == 0) { <tr><td colspan="5">ไม่พบกะที่มีผลต่าง</td></tr> }</tbody></table></div></section></div>
@section Scripts { <script src="~/js/member-live.js" asp-append-version="true"></script> }
