@model AmHerb.Web.Controllers.StoreInventoryPage
@{ ViewData["Title"] = "คลังและประวัติสต็อกร้าน"; }
<h1>คลังและประวัติสต็อกร้าน</h1><partial name="_StoreNav"/>
<p>คลัง @Model.Store.Warehouse.Name · ใช้สต็อกร่วมกับ POS ที่ผูกคลังนี้</p><div class="d-flex flex-wrap gap-2 mb-3"><a href="/Transfers" class="btn btn-success">เบิก / รับสินค้าจากบริษัท</a><a href="/Stock?warehouseId=@Model.Store.WarehouseId" class="btn btn-outline-success">รายงานคงคลังและแจ้งเตือน</a><a href="/Stock/Export?warehouseId=@Model.Store.WarehouseId" class="btn btn-outline-success">ส่งออกสต็อก CSV</a><button type="button" data-print class="btn btn-outline-secondary">พิมพ์</button></div>
<h2 class="h4">ล็อตสินค้า</h2><div class="table-responsive"><table class="table"><thead><tr><th>สินค้า / ล็อต</th><th>หมดอายุ</th><th>พร้อมขาย</th><th>จอง</th><th>สถานะ</th></tr></thead><tbody>@foreach(var l in Model.Lots) { var expired=l.ExpDate<=DateTime.UtcNow; <tr><td><a asp-action="Inventory" asp-route-skuId="@l.SkuId">@l.Sku.Product.Name (@l.Sku.Code)</a><small class="d-block">@l.LotNo</small></td><td>@l.ExpDate.ToString("yyyy-MM-dd")</td><td>@(expired?0:l.QtyAvailable)</td><td>@l.QtyReserved</td><td>@(expired?"หมดอายุ "+l.QtyAvailable+" ชิ้น":l.ExpDate<=DateTime.UtcNow.AddDays(90)?"ใกล้หมดอายุ":"ปกติ")</td></tr> }</tbody></table></div>
<h2 class="h4">ประวัติเคลื่อนไหว</h2><p class="small text-muted">รายการจองลดพร้อมขายแต่ยังไม่ออกจากคลัง การขายตัดยอดจอง ห้ามนำจำนวนของทุกประเภทรวมกันเป็นยอดคงเหลือ</p><div class="table-responsive"><table class="table"><thead><tr><th>รายการ</th><th>SKU / ล็อต</th><th>ประเภท</th><th>จำนวน</th><th>อ้างอิงคำสั่งซื้อ</th><th>เหตุผล</th></tr></thead><tbody>@foreach(var m in Model.Movements) { <tr><td>#@m.Id</td><td>@m.InventoryBatch.Sku.Code / @m.InventoryBatch.LotNo</td><td>@m.Kind</td><td>@m.Quantity</td><td>@m.OrderId</td><td>@m.Reason</td></tr> }</tbody></table></div>
<div class="d-flex gap-3">@if(Model.SkuId != null){<a asp-action="Inventory">ทุกสินค้า</a>}@if(Model.Page>1){<a asp-action="Inventory" asp-route-skuId="@Model.SkuId" asp-route-page="@(Model.Page-1)">ก่อนหน้า</a>}@if(Model.HasNext){<a asp-action="Inventory" asp-route-skuId="@Model.SkuId" asp-route-page="@(Model.Page+1)">ถัดไป</a>}</div>
